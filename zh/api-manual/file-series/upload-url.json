{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - 通过 URL 上传文件",
    "description": "提供远程 URL 即可将文件上传到 Vidgo API。系统会自动从指定位置下载并存储文件。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/common/upload/url": {
      "post": {
        "summary": "通过 URL 上传文件",
        "description": "提供远程 URL 上传文件。系统会从该 URL 下载文件并存储到 Vidgo API 存储中。",
        "operationId": "uploadFileFromUrl",
        "tags": ["File Upload"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlRequest"
              },
              "examples": {
                "basic-upload": {
                  "summary": "基础 URL 上传",
                  "value": {
                    "file_url": "https://example.com/images/sample.jpg"
                  }
                },
                "custom-naming": {
                  "summary": "使用自定义文件名上传",
                  "value": {
                    "file_url": "https://example.com/images/photo.png",
                    "file_name": "my-custom-image.png"
                  }
                },
                "custom-path": {
                  "summary": "使用自定义路径和文件名上传",
                  "value": {
                    "file_url": "https://example.com/images/avatar.webp",
                    "upload_path": "avatars",
                    "file_name": "user-avatar.webp"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "文件上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求错误 - URL 无效、文件类型不支持或下载失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid-url": {
                    "summary": "文件 URL 无效",
                    "value": {
                      "detail": "Failed to download file: HTTPSConnectionPool(host='invalid-url.com', port=443): Max retries exceeded"
                    }
                  },
                  "unsupported-type": {
                    "summary": "文件类型不支持",
                    "value": {
                      "detail": "Unsupported file type: application/pdf"
                    }
                  },
                  "download-failed": {
                    "summary": "下载失败",
                    "value": {
                      "detail": "Failed to download file: Connection timeout"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权 - 缺少认证信息或认证无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "not-authenticated": {
                    "summary": "未认证",
                    "value": {
                      "detail": "Not authenticated"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "超出速率限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "rate-limit": {
                    "summary": "超出速率限制",
                    "value": {
                      "detail": "Rate limit exceeded"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器错误 - 存储连接或上传失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "server-error": {
                    "summary": "服务器错误",
                    "value": {
                      "detail": "Upload failed: Unable to connect to R2 storage"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证\n\n获取 API Key：\n\n进入 **仪表盘 → API 密钥**（[API Key 管理页面](https://vidgo.ai/apis/dashboard/api-key)）获取你的 API Key\n\n在请求头中添加：\n\n```\nAuthorization: Bearer VIDGO_API_KEY\n```"
      }
    },
    "schemas": {
      "UploadUrlRequest": {
        "type": "object",
        "required": ["file_url"],
        "properties": {
          "file_url": {
            "type": "string",
            "format": "uri",
            "description": "要上传的远程文件 URL。\n\n必须是使用 HTTP 或 HTTPS 协议、可公开访问的 URL。\n\n**支持的格式**：JPEG、PNG、GIF、WebP\n\n**注意**：系统会从该 URL 下载文件并存储到 Vidgo API 存储中。",
            "example": "https://example.com/images/sample.jpg"
          },
          "upload_path": {
            "type": "string",
            "description": "自定义存储目录路径。\n\n未指定时，系统会自动对文件分类。\n\n**注意**：无论指定什么路径，所有文件都会以 `temp/` 前缀存储。",
            "example": "avatars"
          },
          "file_name": {
            "type": "string",
            "description": "上传文件的自定义文件名。\n\n未指定时，系统会按以下格式生成唯一文件名：`{timestamp}_{random}_{extension}`\n\n**自动生成的文件名示例**：`20251229130857_a8B9cD2e.png`",
            "example": "my-custom-image.png"
          }
        }
      },
      "UploadResponse": {
        "type": "object",
        "required": ["success", "code", "msg", "data"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true,
            "description": "上传是否成功"
          },
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码"
          },
          "msg": {
            "type": "string",
            "example": "File uploaded successfully",
            "description": "响应消息"
          },
          "data": {
            "type": "object",
            "required": ["file_id", "file_name", "original_name", "file_size", "mime_type", "upload_path", "file_url", "download_url", "upload_time", "expires_at"],
            "properties": {
              "file_id": {
                "type": "string",
                "example": "1bdfdbac6ebc2228d0b398d728bf4699",
                "description": "文件唯一标识（MD5 哈希）"
              },
              "file_name": {
                "type": "string",
                "example": "test-image.png",
                "description": "存储后的文件名"
              },
              "original_name": {
                "type": "string",
                "example": "image-from-url.png",
                "description": "URL 中的原始文件名"
              },
              "file_size": {
                "type": "integer",
                "example": 1419815,
                "description": "文件大小（字节）"
              },
              "mime_type": {
                "type": "string",
                "example": "image/png",
                "description": "上传文件的 MIME 类型"
              },
              "upload_path": {
                "type": "string",
                "example": "temp/test-uploads",
                "description": "存储路径（包含 temp/ 前缀）"
              },
              "file_url": {
                "type": "string",
                "format": "uri",
                "example": "https://cdn.vidgo.ai/temp/test-uploads/test-image.png",
                "description": "上传文件的直接访问 URL"
              },
              "download_url": {
                "type": "string",
                "format": "uri",
                "example": "https://cdn.vidgo.ai/temp/test-uploads/test-image.png",
                "description": "下载 URL（与 file_url 相同）"
              },
              "upload_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-12-29T13:08:57.673515",
                "description": "上传时间戳，ISO 8601 格式"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "example": "2026-01-01T13:08:57.673515",
                "description": "过期时间戳，ISO 8601 格式（上传后 72 小时）"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "string",
            "description": "描述错误原因的错误信息",
            "example": "Not authenticated"
          }
        }
      }
    }
  }
}
