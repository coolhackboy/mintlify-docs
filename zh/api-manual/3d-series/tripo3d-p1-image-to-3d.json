{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Tripo3D P1 图生 3D",
    "description": "使用 Tripo3D P1 将参考图片转为 3D 物体，可选纹理并控制面数。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Tripo3D P1 图生 3D",
        "operationId": "submit_tripo3d_p1_image_to_3d",
        "description": "将下列工作流字段放在 input 内。读取 files 中的每一项：模型资源的 file_type=3d，预览图为 image，辅助文件为 other。保留返回的文件元数据。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "tripo3d/p1/image-to-3d"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图片 URL。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "只能提供一个可公开访问的 HTTP(S) 图片 URL。"
                      },
                      "face_limit": {
                        "type": "integer",
                        "minimum": 48,
                        "maximum": 20000,
                        "description": "目标面数，48 到 20000 的整数。"
                      },
                      "texture": {
                        "type": "boolean",
                        "default": true,
                        "description": "为 true 时生成纹理。默认：true。"
                      },
                      "model_seed": {
                        "type": "integer",
                        "description": "用于复现几何体的整数种子。"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "image_urls"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和可选的 callback_url 放在请求根级。本工作流列出的字段放在 input 内。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "tripo3d/p1/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "texture": true
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "tripo3d/p1/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "texture": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "检查输入值、媒体可访问性和账户可用积分。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
