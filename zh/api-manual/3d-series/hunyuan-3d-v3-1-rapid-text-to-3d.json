{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Hunyuan 3D v3.1 Rapid 文生 3D",
    "description": "使用 Hunyuan 3D v3.1 Rapid 将文字描述的物体概念转为 3D 模型，可选择仅生成几何体以便后续建模。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Hunyuan 3D v3.1 Rapid 文生 3D",
        "operationId": "submit_hunyuan_3d_v3_1_rapid_text_to_3d",
        "description": "使用下列输入参数生成 3D 资产。model 和 callback_url 放在请求根级。模型资源、预览图和附带文件从返回的 files 数组读取。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "hunyuan-3d/v3.1/rapid/text-to-3d"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "描述所需的 3D 物体，1–200 个字符。",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "enable_geometry": {
                        "type": "boolean",
                        "description": "设为 true 时生成仅含几何体的白模。"
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "description": "设为 true 时在纹理模式下生成 PBR 材质。仅几何体生成优先于此设置。"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "prompt"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和 callback_url 放在请求根级，生成参数放在 input 内。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "hunyuan-3d/v3.1/rapid/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "enable_pbr": true,
                      "enable_geometry": false
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "hunyuan-3d/v3.1/rapid/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "enable_pbr": true,
                      "enable_geometry": false
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求校验或账户余额检查失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
