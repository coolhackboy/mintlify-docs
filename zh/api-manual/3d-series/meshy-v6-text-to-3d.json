{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Meshy 6 文生 3D",
    "description": "使用 Meshy 6 根据文本生成 3D 资产，可控制网格拓扑、材质和纹理，并支持可选的骨骼绑定和动画。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Meshy 6 文生 3D",
        "operationId": "submit_meshy_v6_text_to_3d",
        "description": "将下列参数放在 input 内。图片和纹理参考使用可公开访问的 HTTP(S) URL。启用动画时须将 enable_rigging 设为 true。生成的模型、预览图、纹理和动画资源从 files 读取；每一项包含 file_url 和 file_type，有文件元数据时一并返回。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "meshy/v6/text-to-3d"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 600,
                        "minLength": 1,
                        "description": "描述物体、形状和材质，1–600 个字符。"
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "preview",
                          "full"
                        ],
                        "default": "full",
                        "description": "选择 preview 仅生成几何体，或选择 full 运行完整生成流程。默认：full。"
                      },
                      "seed": {
                        "type": "integer",
                        "description": "设置整数种子，以复现某次生成配置。"
                      },
                      "topology": {
                        "type": "string",
                        "enum": [
                          "quad",
                          "triangle"
                        ],
                        "default": "triangle",
                        "description": "选择 triangle 或 quad 网格拓扑。默认：triangle。"
                      },
                      "target_polycount": {
                        "type": "integer",
                        "default": 30000,
                        "description": "以整数设置目标面数。默认：30000。"
                      },
                      "should_remesh": {
                        "type": "boolean",
                        "default": true,
                        "description": "启用重网格化阶段，以应用网格拓扑和面数目标。默认：true。"
                      },
                      "symmetry_mode": {
                        "type": "string",
                        "enum": [
                          "off",
                          "auto",
                          "on"
                        ],
                        "default": "auto",
                        "description": "选择 off、auto 或 on 控制对称性。默认：auto。"
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "description": "为 PBR 材质生成金属度、粗糙度和法线贴图。"
                      },
                      "pose_mode": {
                        "type": "string",
                        "enum": [
                          "a-pose",
                          "t-pose",
                          ""
                        ],
                        "default": "",
                        "description": "选择 a-pose、t-pose 或空字符串作为模型姿势。默认：空字符串。"
                      },
                      "enable_prompt_expansion": {
                        "type": "boolean",
                        "description": "自动扩写文本提示词以引导生成。"
                      },
                      "texture_prompt": {
                        "type": "string",
                        "description": "描述颜色、表面图案和材质，用于引导纹理生成。"
                      },
                      "texture_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "提供可公开访问的 HTTP(S) 图片 URL，用于引导纹理生成。"
                      },
                      "enable_rigging": {
                        "type": "boolean",
                        "description": "为人形角色添加骨骼，用于摆姿势和动画。"
                      },
                      "rigging_height_meters": {
                        "type": "number",
                        "default": 1.7,
                        "description": "启用骨骼绑定时设置角色身高（米）。默认：1.7。"
                      },
                      "enable_animation": {
                        "type": "boolean",
                        "description": "应用动画预设，需将 enable_rigging 设为 true。"
                      },
                      "animation_action_id": {
                        "type": "integer",
                        "default": 1001,
                        "description": "设置整数动画预设 ID。默认：1001。"
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "对生成输入启用安全检查。默认：true。"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "prompt"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和可选的 callback_url 放在请求根级，生成参数放在 input 内。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "meshy/v6/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "mode": "full",
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "should_remesh": true,
                      "symmetry_mode": "auto",
                      "pose_mode": "",
                      "rigging_height_meters": 1.7,
                      "animation_action_id": 1001,
                      "enable_safety_checker": true
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "meshy/v6/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "mode": "full",
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "should_remesh": true,
                      "symmetry_mode": "auto",
                      "pose_mode": "",
                      "rigging_height_meters": 1.7,
                      "animation_action_id": 1001,
                      "enable_safety_checker": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入校验、媒体访问或账户余额错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "拒绝访问",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
