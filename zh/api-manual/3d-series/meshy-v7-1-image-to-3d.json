{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Meshy 7.1 图生 3D",
    "description": "Meshy 7.1 图生 3D API 将一张照片或概念图转换为带纹理的 3D 模型，支持最高 4K 几何细节、Smart Topology、PBR 贴图和骨骼绑定。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Meshy 7.1 图生 3D",
        "operationId": "submit_meshy_v7_1_image_to_3d",
        "description": "只传本模型列出的 `input` 字段。其他字段（包括 `prompt`、`mode`、`seed`）都会返回 400。`image_urls` 必须是只含一个公开 HTTP(S) URL 或 `data:image/...` URI 的数组。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `meshy/v7.1/image-to-3d`。",
                    "example": "meshy/v7.1/image-to-3d"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/sneaker.png"
                        ],
                        "description": "物体的一张图片，公开 HTTP(S) URL 或 `data:image/...` URI（建议 JPG 或 PNG）。"
                      },
                      "model_type": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "smart-topology"
                        ],
                        "default": "standard",
                        "description": "网格模型。`smart-topology` 生成更规整的低面数网格，`target_polycount` 上限为 15000；`geometry_resolution` 需要 `standard`。"
                      },
                      "should_texture": {
                        "type": "boolean",
                        "default": true,
                        "description": "为模型生成纹理。设为 `false` 只生成几何体。生成纹理会增加费用。"
                      },
                      "topology": {
                        "type": "string",
                        "enum": [
                          "triangle",
                          "quad"
                        ],
                        "default": "triangle",
                        "description": "网格拓扑。"
                      },
                      "target_polycount": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 300000,
                        "default": 30000,
                        "description": "目标多边形数量。`model_type: standard` 时为 `100`–`300000`（默认 `30000`）；`smart-topology` 时为 `100`–`15000`（默认 `4000`）。"
                      },
                      "should_remesh": {
                        "type": "boolean",
                        "default": true,
                        "description": "对输出进行重新网格化。设为 `false` 保留原始三角网格。"
                      },
                      "symmetry_mode": {
                        "type": "string",
                        "enum": [
                          "off",
                          "auto",
                          "on"
                        ],
                        "default": "auto",
                        "description": "对称处理方式。"
                      },
                      "pose_mode": {
                        "type": "string",
                        "enum": [
                          "",
                          "a-pose",
                          "t-pose"
                        ],
                        "default": "",
                        "description": "角色姿势。空字符串表示不限定姿势；计划做骨骼绑定的角色适合 `a-pose` 或 `t-pose`。"
                      },
                      "geometry_resolution": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "2k",
                          "4k"
                        ],
                        "description": "几何细节档位：`standard`、`2k` 或 `4k`。需要 `model_type: standard`。该参数控制网格细节，而非纹理尺寸。"
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "default": false,
                        "description": "在基础颜色之外生成 PBR 贴图（金属度、粗糙度、法线）。"
                      },
                      "enable_rigging": {
                        "type": "boolean",
                        "default": false,
                        "description": "将模型自动绑定为人形角色骨骼。会增加费用。"
                      },
                      "enable_animation": {
                        "type": "boolean",
                        "default": false,
                        "description": "应用 `animation_action_id` 指定的动画预设。需要 `enable_rigging: true`。会增加费用。"
                      },
                      "rigging_height_meters": {
                        "type": "number",
                        "default": 1.7,
                        "description": "骨骼绑定使用的角色身高（米），必须大于 0。"
                      },
                      "animation_action_id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 696,
                        "default": 92,
                        "description": "动画预设 ID，`0`–`696`。"
                      },
                      "texture_prompt": {
                        "type": "string",
                        "maxLength": 600,
                        "description": "纹理的文字引导，最多 600 个字符。"
                      },
                      "texture_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "用于引导纹理的图片，公开 HTTP(S) URL 或 `data:image/...` URI。"
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "启用上游安全检查。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "textured": {
                  "summary": "用产品照片生成带纹理模型",
                  "value": {
                    "model": "meshy/v7.1/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/sneaker.png"
                      ],
                      "should_texture": true,
                      "geometry_resolution": "4k",
                      "enable_pbr": true
                    }
                  }
                },
                "smart_topology": {
                  "summary": "使用 Smart Topology 的低面数游戏资产",
                  "value": {
                    "model": "meshy/v7.1/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/treasure-chest.png"
                      ],
                      "model_type": "smart-topology",
                      "topology": "quad",
                      "target_polycount": 4000
                    }
                  }
                },
                "rigged_character": {
                  "summary": "带骨骼绑定的角色，带回调",
                  "value": {
                    "model": "meshy/v7.1/image-to-3d",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/character-concept.png"
                      ],
                      "pose_mode": "a-pose",
                      "enable_rigging": true,
                      "rigging_height_meters": 1.8
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
