{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Generate Music Cover API",
    "description": "为生成的音乐创建封面图片。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交音乐封面生成任务",
        "description": "为现有音乐曲目生成封面图片",
        "operationId": "submitMusicCoverTask",
        "tags": ["Music Cover"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "basic-cover": {
                  "summary": "基础封面生成",
                  "value": {
                    "model": "generate-music-cover",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "task_id": "73d6128b3523a0079df10da9471017c8"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证\n\n获取 API Key：\n\n进入 **仪表盘 → API 密钥**（[API Key 管理页面](https://vidgo.ai/apis/dashboard/api-key)）获取你的 API Key\n\n在请求头中添加：\n\n```\nAuthorization: Bearer VIDGO_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "callback_url", "input"],
        "properties": {
          "model": {
            "type": "string",
            "example": "generate-music-cover"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "用于结果通知的 Webhook 回调 URL。\n\n封面生成完成后，系统会向此 URL 发送 POST 请求，包含任务状态和结果。",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["task_id"],
            "description": "封面生成的输入参数",
            "properties": {
              "task_id": {
                "type": "string",
                "description": "原始音乐任务 ID。\n\n应为音乐生成接口返回的 task_id。",
                "example": "73d6128b3523a0079df10da9471017c8"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码"
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started"],
                "example": "not_started",
                "description": "初始任务状态"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "HTTP 状态码"
          },
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
