  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证\n\n获取 API Key：\n\n进入 **仪表盘 → API 密钥**（[API Key 管理页面](https://vidgo.ai/apis/dashboard/api-key)）获取你的 API Key\n\n在请求头中添加：\n\n```\nAuthorization: Bearer VIDGO_API_KEY\n```"
      }
    },
    "schemas": {
      "DetailResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码"
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "files", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "8FDN1I7M7Q68DDG8",
                "description": "唯一任务标识"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "finished",
                "description": "任务当前状态。\n\n- `not_started`：任务已排队，尚未开始处理\n- `running`：任务正在处理中\n- `finished`：任务已成功完成\n- `failed`：任务因错误而失败"
              },
              "files": {
                "type": "array",
                "description": "生成的文件数组。\n\n响应字段取决于创建任务的模型。详见[files 数据响应字段](#files-数据响应字段)。\n\n任务未完成或已失败时为空数组。",
                "items": {
                  "$ref": "#/components/schemas/AudioFile"
                }
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-25T08:50:13",
                "description": "任务创建时间，ISO 8601 时间戳"
              },
              "error_message": {
                "type": "string",
                "nullable": true,
                "example": null,
                "description": "任务失败时的错误信息。\n\n任务成功或仍在处理中时为 `null`。"
              }
            }
          }
        }
      },
      "AudioFile": {
        "type": "object",
        "required": ["audio_id", "audio_url", "image_url", "title", "tags", "duration"],
        "properties": {
          "audio_id": {
            "type": "string",
            "example": "62e4542a-73be-44e1-b397-7716ee7505c6",
            "description": "该音频文件的唯一标识"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "example": "https://file.goseaapp.com/audio/8FDN1I7M7Q68DDG8/20251125113627_QIivN2_tmphb8rgpeb_audio_62e4542a-73be-44e1-b397-7716ee7505c6.mp3",
            "description": "生成音频文件的直接下载 URL"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "example": "https://file.goseaapp.com/audio/8FDN1I7M7Q68DDG8/20251125113628_4DfWp6_tmpz72j05o5_cover_62e4542a-73be-44e1-b397-7716ee7505c6.jpeg",
            "description": "该音频文件封面图的直接 URL"
          },
          "title": {
            "type": "string",
            "example": "Peaceful Piano Meditation",
            "description": "生成曲目的标题"
          },
          "tags": {
            "type": "string",
            "example": "Classical",
            "description": "生成曲目的风格标签"
          },
          "duration": {
            "type": "number",
            "example": 240.0,
            "description": "音频文件时长（秒）"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "HTTP 状态码"
          },
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
