{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Qwen Image 3.0 Pro 文生图",
    "description": "通过 Vidgo 统一生成 API 调用 Qwen Image 3.0 Pro 文生图。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Qwen Image 3.0 Pro 文生图任务",
        "operationId": "submitQwenImage30ProTextToImageTask",
        "tags": [
          "Qwen Image 3.0 Pro Text to Image"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "Qwen Image 3.0 Pro 文生图",
                  "value": {
                    "model": "qwen-image-3.0-pro/text-to-image",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic scene with natural lighting and coherent motion",
                      "resolution": "1K",
                      "size": "1:1"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "qwen-image-3.0-pro/text-to-image"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述要生成或编辑的图像的文字指令。",
                "maxLength": 5000
              },
              "size": {
                "type": "string",
                "description": "输出宽高比。",
                "enum": [
                  "1:1",
                  "3:2",
                  "2:3",
                  "4:3",
                  "3:4",
                  "16:9",
                  "9:16",
                  "21:9"
                ],
                "default": "1:1"
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率。",
                "enum": [
                  "1K",
                  "2K"
                ],
                "default": "1K"
              },
              "output_format": {
                "type": "string",
                "description": "输出图像格式。",
                "enum": [
                  "png",
                  "jpeg"
                ]
              },
              "enable_safety_checker": {
                "type": "boolean",
                "description": "是否开启内容安全检查。"
              },
              "prompt_extend": {
                "type": "boolean",
                "description": "是否自动增强提示词。"
              },
              "negative_prompt": {
                "type": "string",
                "description": "不希望出现在输出中的内容。",
                "maxLength": 5000
              },
              "seed": {
                "type": "integer",
                "description": "可选的确定性种子。",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-10T08:00:00Z"
              }
            }
          }
        }
      }
    }
  }
}
