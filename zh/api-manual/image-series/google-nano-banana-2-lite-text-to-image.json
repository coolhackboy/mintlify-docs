{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Nano Banana 2 Lite 文生图",
    "description": "使用 Nano Banana 2 Lite 将视觉创意生成为图像，提供竖版、横版和宽幅构图等画幅选项。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Nano Banana 2 Lite 文生图",
        "operationId": "submit_google_nano_banana_2_lite_text_to_image",
        "description": "只发送本工作流列出的字段。其他工作流的参数会在扣除积分前被拒绝。\n\n必填的 prompt 不能为空。\n\n按次计费。文生图和图像编辑使用相同的计费标准。所选宽高比（`size`）和参考图数量不会额外计费。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "google/nano-banana-2-lite/text-to-image"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "description": "必填的非空文字指令，用于描述要生成或编辑的图像。未规定最大长度。"
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "3:4",
                          "4:3",
                          "4:5",
                          "5:4",
                          "9:16",
                          "16:9",
                          "21:9"
                        ],
                        "description": "可选的输出宽高比。省略时不指定宽高比。没有默认值；不支持 auto。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即关闭回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础流程",
                  "value": {
                    "model": "google/nano-banana-2-lite/text-to-image",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail."
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "google/nano-banana-2-lite/text-to-image",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail."
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
