                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "任务创建错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
