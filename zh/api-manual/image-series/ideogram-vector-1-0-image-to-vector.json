{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Ideogram Vector 1.0 图片转 SVG",
    "description": "Ideogram Vector 1.0 图片转 SVG API 将一张 PNG、JPG 或 WebP 图片转换为可编辑的 SVG 文件，可选 default（细节丰富）或 simple 模式。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Ideogram Vector 1.0 图片转 SVG",
        "operationId": "submit_ideogram_vector_1_0_image_to_vector",
        "description": "只传本模型列出的 `input` 字段。其他字段（包括 `prompt`）都会返回 400。`image_urls` 接受公开 HTTP(S) URL 或 `data:image/...;base64,...` 格式的 data URI。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `ideogram/vector-1.0/image-to-vector`。",
                    "example": "ideogram/vector-1.0/image-to-vector"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/logo.png"
                        ],
                        "description": "恰好一张要矢量化的位图：公开 HTTP(S) URL 或图片 data URI。"
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "default",
                          "simple"
                        ],
                        "default": "default",
                        "description": "矢量化风格。`default` 保留更多细节；`simple` 使用更少、更简洁的形状。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "default_mode": {
                  "summary": "以 default 模式矢量化 Logo",
                  "value": {
                    "model": "ideogram/vector-1.0/image-to-vector",
                    "input": {
                      "image_urls": [
                        "https://example.com/logo.png"
                      ],
                      "mode": "default"
                    }
                  }
                },
                "simple_mode": {
                  "summary": "simple 模式，带回调",
                  "value": {
                    "model": "ideogram/vector-1.0/image-to-vector",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/sketch.jpg"
                      ],
                      "mode": "simple"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
