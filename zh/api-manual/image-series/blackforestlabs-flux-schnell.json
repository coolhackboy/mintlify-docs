{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Flux Schnell 文生图",
    "description": "Flux Schnell 文生图 API。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Flux Schnell 文生图任务",
        "operationId": "submitFluxSchnellTextToImage",
        "tags": [
          "Flux Schnell"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "崖边泳池的第一缕晨光",
                  "value": {
                    "model": "blackforestlabs/flux/schnell",
                    "input": {
                      "prompt": "An architectural photograph of an empty public seawater swimming pool built into a coastal cliff at sunrise. From a low viewpoint beside the pool, pale turquoise water fills the foreground, broad curved stone steps descend naturally into the shallow end on the right, and a simple white limewashed wall catches moving water reflections. Warm low morning sunlight reveals the rough limestone coping and delicate ripples. Beyond the far pool edge, the calm open sea and a clean level horizon remain clearly visible. Restrained Mediterranean colors, believable pool geometry, natural light, crisp tactile surfaces, peaceful everyday public architecture. One coherent full-frame photograph, no people, hotel styling, advertising, signs, lettering, logos or watermark.",
                      "size": "4:3",
                      "n": 1,
                      "output_format": "png"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "RGOGR6Z9UO0KX623",
                    "status": "running",
                    "created_time": "2026-09-25T11:31:42"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "blackforestlabs/flux/schnell"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "文生图参数。",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述要生成的图像或要做的修改。去除首尾空白后至少一个字符。",
                "minLength": 1,
                "example": "An architectural photograph of an empty public seawater swimming pool built into a coastal cliff at sunrise. From a low viewpoint beside the pool, pale turquoise water fills the foreground, broad curved stone steps descend naturally into the shallow end on the right, and a simple white limewashed wall catches moving water reflections. Warm low morning sunlight reveals the rough limestone coping and delicate ripples. Beyond the far pool edge, the calm open sea and a clean level horizon remain clearly visible. Restrained Mediterranean colors, believable pool geometry, natural light, crisp tactile surfaces, peaceful everyday public architecture. One coherent full-frame photograph, no people, hotel styling, advertising, signs, lettering, logos or watermark."
              },
              "size": {
                "type": "string",
                "description": "输出画布。预设：1:1（512×512）、1:1 HD（1024×1024）、4:3（1024×768）、3:4（768×1024）、16:9（1024×576）、9:16（576×1024）。自定义 WIDTHxHEIGHT 尺寸为正整数。\n\n使用预设（`1:1`、`1:1 HD`、`4:3`、`3:4`、`16:9`、`9:16`）或自定义 `WIDTHxHEIGHT` 尺寸。",
                "default": "1:1",
                "example": "4:3"
              },
              "n": {
                "type": "integer",
                "description": "输出图像数量。",
                "default": 1,
                "example": 1,
                "minimum": 1
              },
              "output_format": {
                "type": "string",
                "description": "输出图像格式。",
                "enum": [
                  "jpeg",
                  "png"
                ],
                "default": "png",
                "example": "png"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
