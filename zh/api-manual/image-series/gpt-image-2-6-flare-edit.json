{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - GPT Image 2.6 Flare 图像编辑",
    "description": "GPT Image 2.6 Flare 图像编辑 API 基于 1–16 张参考图编辑出一张 1K、2K 或 4K 图像，支持可选蒙版、透明背景和输出压缩。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 GPT Image 2.6 Flare 图像编辑任务",
        "operationId": "submitGPTImage26FlareImageEditTask",
        "tags": [
          "GPT Image 2.6 Flare Image Edit"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "reference-edit": {
                  "summary": "使用参考图编辑",
                  "value": {
                    "model": "openai/gpt-image-2.6-flare/edit",
                    "input": {
                      "prompt": "Preserve the product and replace the background with a warm modern studio.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-product.png"
                      ],
                      "resolution": "2K"
                    }
                  }
                },
                "mask-edit": {
                  "summary": "编辑蒙版区域",
                  "value": {
                    "model": "openai/gpt-image-2.6-flare/edit",
                    "input": {
                      "prompt": "Replace the masked area with a small vase of flowers.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-product.png"
                      ],
                      "mask_url": "https://cdn.vidgo.ai/temp/edit-mask.png",
                      "size": "auto"
                    }
                  }
                },
                "transparent-background": {
                  "summary": "编辑并输出透明背景图像",
                  "value": {
                    "model": "openai/gpt-image-2.6-flare/edit",
                    "input": {
                      "prompt": "Keep the silver robot and remove its background.",
                      "background": "transparent",
                      "output_format": "webp",
                      "resolution": "4K",
                      "quality": "xhigh",
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-product.png"
                      ]
                    }
                  }
                },
                "custom-size": {
                  "summary": "使用自定义尺寸编辑",
                  "value": {
                    "model": "openai/gpt-image-2.6-flare/edit",
                    "input": {
                      "prompt": "Preserve the product and place it in a panoramic city garden.",
                      "size": "2304x1536",
                      "resolution": "2K",
                      "quality": "medium",
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-product.png"
                      ]
                    }
                  }
                },
                "compressed-jpeg": {
                  "summary": "压缩 JPEG 输出",
                  "value": {
                    "model": "openai/gpt-image-2.6-flare/edit",
                    "input": {
                      "prompt": "Place the product on a linen tablecloth with soft window light.",
                      "size": "3:2",
                      "quality": "medium",
                      "output_format": "jpeg",
                      "output_compression": 80,
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-product.png"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交结果。任务 ID 标识一项异步任务；生成可能仍在进行中。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "openai/gpt-image-2.6-flare/edit"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook URL，用于接收完成或失败通知。",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000,
                "description": "描述编辑内容的文字指令。\n\n至少包含一个非空白字符。"
              },
              "size": {
                "type": "string",
                "description": "输出宽高比预设、auto 或自定义 WIDTHxHEIGHT。\n\n省略时输出跟随第一张参考图的宽高比（在所选分辨率下取最接近的支持比例）。\n\n预设：`1:1`、`2:3`、`3:2`、`4:3`、`3:4`、`4:5`、`5:4`、`16:9`、`9:16`、`21:9`。\n\n`auto` 由模型决定尺寸，可与任意分辨率搭配，按 1K 计费。\n\n自定义尺寸可与任意分辨率搭配：两条边都是 16 的倍数，最长边不超过 3840，宽高比不超过 3:1，总像素数 655360–8294400。宽和高之间用 `x` 或 `X` 分隔。按总像素数对应的档位计费（不超过 1572864 为 1K，不超过 4194304 为 2K，更大为 4K），所选分辨率更高时按所选分辨率。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "输出分辨率档位。"
              },
              "image_urls": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "使用公开可访问的 HTTP(S) 下载 URL。"
                },
                "description": "编辑所需的参考图，按提示词中的顺序排列。",
                "minItems": 1
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg",
                  "webp"
                ],
                "default": "png",
                "description": "输出图像格式。\n\n透明输出需要 PNG 或 WebP。"
              },
              "output_compression": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "输出图像的压缩级别，0 到 100。\n\n仅当 output_format 为 jpeg 或 webp 时可用，其他格式返回 400。省略时使用默认压缩。"
              },
              "quality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "high",
                "description": "图像质量档位。\n\n计费取决于质量和计费档位。"
              },
              "background": {
                "type": "string",
                "enum": [
                  "auto",
                  "transparent",
                  "opaque"
                ],
                "default": "auto",
                "description": "背景模式。\n\n透明输出需要 PNG 或 WebP。"
              },
              "mask_url": {
                "type": "string",
                "format": "uri",
                "description": "可选蒙版，用于选定要编辑的区域。\n\n需要至少一张参考图。\n\n使用公开可访问的 HTTP(S) 下载 URL。"
              },
              "moderation": {
                "type": "string",
                "enum": [
                  "auto",
                  "low"
                ],
                "default": "auto",
                "description": "内容审核严格程度。\n\nlow 过滤更宽松。"
              },
              "complexity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "default": "high",
                "description": "模型生成前的规划力度。\n\n不影响价格。"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-example-001"
              },
              "status": {
                "type": "string",
                "example": "not_started"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-09T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "错误信息。参见[错误码](/zh/api-manual/error-codes)。",
            "example": "prompt is required"
          }
        }
      }
    }
  }
}
