{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Grok Imagine Image 2.0 图像编辑",
    "description": "使用 Grok Imagine Image 2.0 细化图像，结合参考图和精确指令，在修改视觉细节的同时保留主体。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Grok Imagine Image 2.0 图像编辑",
        "operationId": "submit_xai_grok_imagine_image_v2_0_edit",
        "description": "只发送本工作流列出的字段。其他工作流的参数会在扣除积分前被拒绝。\n\n提供 prompt 时不能为空。输入 URL 字段须为带主机名、不含内嵌凭证的 HTTP(S) URL。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "xai/grok-imagine-image-v2.0/edit"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000,
                        "description": "必填的非空字符串，去除首尾空白后为 1–8,000 个字符。非字符串值会被拒绝。"
                      },
                      "image_urls": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图像 URL。"
                        },
                        "description": "编辑必填：1–3 个公开的 HTTP(S) 图像 URL，不含内嵌凭证。输入图像数量会按请求单独计费一次，与输出数量（n）无关。"
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4,
                        "default": 1,
                        "description": "输出图像数量。1 到 4 的整数，默认 1。字符串、布尔值和小数会被拒绝。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "9:16",
                          "16:9"
                        ],
                        "default": "1:1",
                        "description": "输出宽高比。默认 1:1。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "1K",
                          "2K"
                        ],
                        "default": "1K",
                        "description": "输出分辨率档位：1K 或 2K。默认 1K。"
                      },
                      "quality": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium"
                        ],
                        "default": "medium",
                        "description": "输出质量：low 或 medium。默认 medium。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即关闭回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础流程",
                  "value": {
                    "model": "xai/grok-imagine-image-v2.0/edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "n": 1,
                      "aspect_ratio": "1:1",
                      "resolution": "1K",
                      "quality": "medium"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "xai/grok-imagine-image-v2.0/edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "n": 1,
                      "aspect_ratio": "1:1",
                      "resolution": "1K",
                      "quality": "medium"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "multiple_outputs": {
                  "summary": "三张输入图、四张 Medium / 2K 输出",
                  "value": {
                    "model": "xai/grok-imagine-image-v2.0/edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/input-1.png",
                        "https://example.com/input-2.png",
                        "https://example.com/input-3.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "n": 4,
                      "aspect_ratio": "1:1",
                      "resolution": "2K",
                      "quality": "medium"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
