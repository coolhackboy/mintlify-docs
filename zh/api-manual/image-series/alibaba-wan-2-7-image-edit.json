{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Wan 2.7 Image 图像编辑",
    "description": "使用 Wan 2.7，通过文字指令和最多四张视觉参考改造图像，探索新的构图和变体。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Wan 2.7 Image 图像编辑",
        "operationId": "submit_alibaba_wan_2_7_image_edit",
        "description": "只发送本工作流列出的字段。其他工作流的参数会在扣除积分前被拒绝。\n\n提供 prompt 时不能为空。输入 URL 字段须为带主机名、不含内嵌凭证的 HTTP(S) URL。\n\n自定义尺寸的宽和高都必须为正数。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/wan-2.7/image-edit"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "description": "此公开接口的输入参数。需要提供参考图时请使用图像编辑接口。",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "描述期望输出的提示词。最大长度 5,000 个字符。",
                        "maxLength": 5000,
                        "example": "A beautiful sunset over the ocean",
                        "minLength": 1
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 4,
                        "description": "用于编辑的参考图（必须 1-4 张）。顺序有意义：在提示词中以 image 1、image 2、image 3、image 4 引用。",
                        "example": [
                          "https://example.com/reference1.jpg"
                        ]
                      },
                      "size": {
                        "description": "输出尺寸。支持的预设值：`512x512`、`1024x1024`、`768x1024`、`1024x768`、`576x1024`、`1024x576`。自定义图像尺寸时，可以以对象形式传入 `width` 和 `height`：`{ \"width\": 1280, \"height\": 720 }`。",
                        "oneOf": [
                          {
                            "type": "string",
                            "enum": [
                              "512x512",
                              "1024x1024",
                              "768x1024",
                              "1024x768",
                              "576x1024",
                              "1024x576"
                            ],
                            "example": "1024x1024",
                            "title": "尺寸字符串"
                          },
                          {
                            "type": "object",
                            "required": [
                              "width",
                              "height"
                            ],
                            "properties": {
                              "width": {
                                "type": "integer",
                                "minimum": 1,
                                "example": 1280
                              },
                              "height": {
                                "type": "integer",
                                "minimum": 1,
                                "example": 720
                              }
                            },
                            "additionalProperties": false,
                            "title": "宽和高"
                          }
                        ],
                        "default": "1024x1024",
                        "example": "1024x1024"
                      },
                      "n": {
                        "type": "integer",
                        "description": "要生成的图像数量（1-4）。积分按图像数量扣除。",
                        "minimum": 1,
                        "maximum": 4,
                        "default": 1,
                        "example": 1
                      },
                      "seed": {
                        "type": "integer",
                        "description": "可选的随机种子，用于复现输出",
                        "example": 24680
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即关闭回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础流程",
                  "value": {
                    "model": "alibaba/wan-2.7/image-edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "size": "1024x1024",
                      "n": 1
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "alibaba/wan-2.7/image-edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "size": "1024x1024",
                      "n": 1
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "preset-size": {
                  "summary": "预设尺寸",
                  "value": {
                    "model": "alibaba/wan-2.7/image-edit",
                    "input": {
                      "prompt": "A product photo on a pale blue background",
                      "size": "1024x1024",
                      "n": 2,
                      "seed": 24680,
                      "image_urls": [
                        "https://example.com/reference1.jpg"
                      ]
                    }
                  }
                },
                "custom-size": {
                  "summary": "自定义尺寸",
                  "value": {
                    "model": "alibaba/wan-2.7/image-edit",
                    "input": {
                      "prompt": "A product photo on a pale blue background",
                      "size": {
                        "width": 1280,
                        "height": 720
                      },
                      "n": 2,
                      "seed": 24680,
                      "image_urls": [
                        "https://example.com/reference1.jpg"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
