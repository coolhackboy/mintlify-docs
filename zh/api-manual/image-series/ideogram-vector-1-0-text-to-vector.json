{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Ideogram Vector 1.0 文本生成 SVG",
    "description": "Ideogram Vector 1.0 文本生成 SVG API 根据提示词生成 1–8 个 SVG 文件，支持最多 5 张参考图、18 种宽高比选项和三档质量。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Ideogram Vector 1.0 文本生成 SVG",
        "operationId": "submit_ideogram_vector_1_0_text_to_vector",
        "description": "只传本模型列出的 `input` 字段，其他字段会返回 400。`image_urls` 接受公开 HTTP(S) URL 或 `data:image/...;base64,...` 格式的 data URI。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `ideogram/vector-1.0/text-to-vector`。",
                    "example": "ideogram/vector-1.0/text-to-vector"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 9500,
                        "example": "Flat line icon set of a rocket, a planet and a star, two-colour navy and coral",
                        "description": "描述矢量作品：主体、风格、配色以及需要的文字（用引号标出）。1–9,500 个字符，不能为空白。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 5,
                        "description": "可选的参考图，传入时为 1–5 张。第一张为主要参考。公开 HTTP(S) URL 或图片 data URI。"
                      },
                      "quality": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ],
                        "default": "medium",
                        "description": "渲染质量，决定计费档位。"
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8,
                        "default": 1,
                        "description": "生成的 SVG 文件数量。"
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "1:1",
                          "1:4",
                          "1:3",
                          "1:2",
                          "9:16",
                          "10:16",
                          "2:3",
                          "3:4",
                          "4:5",
                          "5:4",
                          "4:3",
                          "3:2",
                          "16:10",
                          "16:9",
                          "2:1",
                          "3:1",
                          "4:1"
                        ],
                        "default": "auto",
                        "description": "作品的宽高比。`auto` 由模型决定。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "icon": {
                  "summary": "仅提示词生成 SVG 图标",
                  "value": {
                    "model": "ideogram/vector-1.0/text-to-vector",
                    "input": {
                      "prompt": "Flat line icon set of a rocket, a planet and a star, two-colour navy and coral",
                      "quality": "medium",
                      "n": 2,
                      "size": "1:1"
                    }
                  }
                },
                "with_reference": {
                  "summary": "带风格参考图的横幅，带回调",
                  "value": {
                    "model": "ideogram/vector-1.0/text-to-vector",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Wide banner illustration of rolling hills at sunrise with the word \"TRAILHEAD\" in bold geometric letters",
                      "image_urls": [
                        "https://example.com/brand-style.png"
                      ],
                      "quality": "high",
                      "n": 1,
                      "size": "3:1"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
