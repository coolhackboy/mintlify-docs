{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Nano Banana 图像编辑",
    "description": "使用 Nano Banana，通过文字指令和视觉参考重新演绎已有图像，生成新的场景、风格和构图。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Nano Banana 图像编辑",
        "operationId": "submit_google_nano_banana_edit",
        "description": "提交 Nano Banana 任务：model 和可选的 callback_url 放在请求根级，生成参数放在 input 内。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "google/nano-banana/edit",
                    "enum": [
                      "google/nano-banana/edit"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 1,
                        "description": "描述要对图像做的修改，1–5,000 个字符，且至少包含一个非空白字符。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "公开可访问的 HTTP(S) 图像 URL。"
                        },
                        "minItems": 1,
                        "description": "要编辑的参考图。至少提供一个公开可访问的 HTTP(S) 图像 URL。"
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "3:4",
                          "4:3",
                          "4:5",
                          "5:4",
                          "9:16",
                          "16:9",
                          "21:9"
                        ],
                        "description": "输出图像宽高比。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "公开的 HTTP(S) URL，任务变为 finished 或 failed 时会向其发送 POST 通知。"
                  }
                },
                "description": "model 和可选的 callback_url 放在请求根级，生成参数放在 input 内。"
              },
              "examples": {
                "basic": {
                  "summary": "基础流程",
                  "value": {
                    "model": "google/nano-banana/edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "Add colorful flowers in the foreground.",
                      "size": "16:9"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "google/nano-banana/edit",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "Add colorful flowers in the foreground.",
                      "size": "16:9"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求校验错误或账户余额不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
