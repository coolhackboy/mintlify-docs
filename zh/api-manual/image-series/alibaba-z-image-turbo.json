{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Z-Image Turbo",
    "description": "使用 Z-Image Turbo 进行文生图和单图编辑。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Z-Image Turbo 任务",
        "operationId": "submitZImageTurboTask",
        "tags": [
          "Z-Image Turbo"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "文生图",
                  "value": {
                    "model": "alibaba/z-image/turbo",
                    "input": {
                      "prompt": "A ceramic vase on a wooden table in soft daylight.",
                      "size": "1:1",
                      "enable_safety_checker": true
                    }
                  }
                },
                "image-editing": {
                  "summary": "图像编辑",
                  "value": {
                    "model": "alibaba/z-image/turbo",
                    "input": {
                      "prompt": "Add soft studio lighting to this product photo.",
                      "image_urls": [
                        "https://example.com/reference.png"
                      ],
                      "enable_safety_checker": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        },
        "description": "根据提示词生成图像，或编辑一张参考图。"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "alibaba/z-image/turbo"
            ],
            "example": "alibaba/z-image/turbo",
            "description": "Z-Image Turbo 模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "图像生成参数。文生图时 size 必填；通过 image_urls 提供编辑参考图时可选。\n\n`size`、`image_urls` 至少提供一个。",
            "anyOf": [
              {
                "required": [
                  "size"
                ]
              },
              {
                "required": [
                  "image_urls"
                ]
              }
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "描述要生成的图像或要做的编辑，1 到 1000 个字符。",
                "example": "A ceramic vase on a wooden table in soft daylight."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "使用公开可访问的 HTTP(S) 下载 URL。"
                },
                "description": "一个用作编辑参考的 HTTP(S) 图像 URL。提供此字段即选择图像编辑。",
                "example": [
                  "https://example.com/reference.png"
                ]
              },
              "size": {
                "type": "string",
                "enum": [
                  "1:1",
                  "4:3",
                  "3:4",
                  "16:9",
                  "9:16"
                ],
                "description": "输出宽高比。文生图必填；图像编辑可选。",
                "example": "1:1"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "开启安全检查。默认 true。",
                "example": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
