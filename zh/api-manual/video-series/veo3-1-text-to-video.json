{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Veo 3.1 Quality 文生视频",
    "description": "通过 Vidgo 统一生成 API 调用 Veo 3.1 Quality 文生视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Veo 3.1 Quality 文生视频任务",
        "operationId": "submitVeo31TextToVideoTask",
        "tags": [
          "Veo 3.1 Quality Text to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "Veo 3.1 Quality 文生视频",
                  "value": {
                    "model": "veo3.1/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic scene with natural lighting and coherent motion",
                      "duration": 8,
                      "resolution": "720p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "veo3.1/text-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述目标视频的提示词。"
              },
              "duration": {
                "type": "integer",
                "description": "Veo 3.1 输出时长固定为 8 秒。",
                "enum": [
                  8
                ],
                "default": 8
              },
              "aspect_ratio": {
                "type": "string",
                "description": "输出宽高比。",
                "enum": [
                  "16:9",
                  "9:16"
                ]
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率。",
                "enum": [
                  "720p",
                  "1080p",
                  "4k"
                ],
                "default": "720p"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
