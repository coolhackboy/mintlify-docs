{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedance 1.5 Pro 图生视频",
    "description": "使用 Seedance 1.5 Pro 让参考图动起来，可选生成音频并控制固定镜头，输出最高 1080p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Seedance 1.5 Pro 图生视频",
        "operationId": "submit_bytedance_seedance_v1_5_pro_image_to_video",
        "description": "提交 Seedance 1.5 Pro 图生视频任务。model 和可选的 callback_url 放在请求根级，生成参数放在 input 中。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "bytedance/seedance-v1.5-pro/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "aspect_ratio",
                      "duration",
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2500,
                        "description": "描述场景、主体动作、镜头运动和声音。去除首尾空白后为 3–2,500 个 Unicode 字符。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "JPEG、PNG 或 WebP 图片的公开 HTTP(S) URL。"
                        },
                        "maxItems": 2,
                        "minItems": 1,
                        "description": "按顺序提供 1–2 个可公开访问的 HTTP(S) 图片 URL：首帧，然后是可选的尾帧。使用 JPEG、PNG 或 WebP 图片，每张不超过 10 MB。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "21:9",
                          "4:3",
                          "3:4",
                          "16:9",
                          "9:16"
                        ],
                        "description": "输出画面宽高比：1:1、21:9、4:3、3:4、16:9 或 9:16。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "480p",
                          "720p",
                          "1080p"
                        ],
                        "description": "输出分辨率：480p、720p 或 1080p。省略时 Vidgo 默认为 720p。",
                        "default": "720p"
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          4,
                          8,
                          12
                        ],
                        "description": "视频时长（秒）。传整数 4、8 或 12。"
                      },
                      "fixed_lens": {
                        "type": "boolean",
                        "description": "设为 true 固定镜头，设为 false 允许镜头运动。"
                      },
                      "generate_audio": {
                        "type": "boolean",
                        "description": "设为 true 生成同步音频，设为 false 生成无声视频。省略时 Vidgo 默认为 true。",
                        "default": true
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选，接收任务完成通知的公开 HTTP(S) URL。使用 HTTPS 以接收 finished 或 failed 的任务结果。"
                  }
                },
                "description": "model 和可选的 callback_url 放在请求根级，生成参数放在 input 中。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "bytedance/seedance-v1.5-pro/image-to-video",
                    "input": {
                      "aspect_ratio": "1:1",
                      "duration": 4,
                      "generate_audio": false,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "480p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "bytedance/seedance-v1.5-pro/image-to-video",
                    "input": {
                      "aspect_ratio": "1:1",
                      "duration": 4,
                      "generate_audio": false,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "480p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求校验或账户余额错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
