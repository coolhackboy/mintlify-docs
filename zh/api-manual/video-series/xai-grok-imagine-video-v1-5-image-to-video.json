{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Grok Imagine Video 1.5 图生视频",
    "description": "使用 Grok Imagine Video 1.5 将参考图转为视频，输出最高 1080p，片段时长 1 到 15 秒。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Grok Imagine Video 1.5 图生视频",
        "operationId": "submit_xai_grok_imagine_video_v1_5_image_to_video",
        "description": "使用运动提示词让一张首帧图片动起来。可选择输出分辨率和时长。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "xai/grok-imagine-video-v1.5/image-to-video",
                    "enum": [
                      "xai/grok-imagine-video-v1.5/image-to-video"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "image_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 4096,
                        "minLength": 1,
                        "description": "描述主体运动、镜头运动和声音，1–4096 个字符。"
                      },
                      "image_urls": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图片 URL。"
                        },
                        "description": "提供恰好一个可公开访问的 HTTP(S) 图片 URL 作为首帧。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "480p",
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率。默认：720p。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "description": "整数视频时长，1 到 15 秒。默认：6。",
                        "default": 6
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选，接收任务完成通知的公开 HTTP(S) 地址，建议使用 HTTPS。省略、传 null 或传空字符串即不启用回调。"
                  }
                },
                "description": "model 和 callback_url 放在请求根级，生成参数放在 input 中。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "xai/grok-imagine-video-v1.5/image-to-video",
                    "input": {
                      "duration": 6,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "xai/grok-imagine-video-v1.5/image-to-video",
                    "input": {
                      "duration": 6,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
