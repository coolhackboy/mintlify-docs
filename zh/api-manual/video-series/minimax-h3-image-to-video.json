{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax H3 图生视频",
    "description": "通过 Vidgo 统一生成 API 使用 MiniMax H3 图生视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 MiniMax H3 图生视频任务",
        "operationId": "submitMinimaxH3ImageToVideoTask",
        "tags": [
          "MiniMax H3 Image to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "MiniMax H3 图生视频",
                  "value": {
                    "model": "minimax/h3/image-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic scene with natural lighting and coherent motion",
                      "duration": 5,
                      "resolution": "2K",
                      "image_urls": [
                        "https://cdn.vidgo.ai/temp/reference-1.jpg"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1787970600-abcd1234",
                    "status": "not_started",
                    "created_time": "2026-08-29T10:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax/h3/image-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述目标视频的提示词。",
                "minLength": 1,
                "maxLength": 2000
              },
              "duration": {
                "type": "integer",
                "description": "输出时长（秒）。",
                "minimum": 5,
                "maximum": 15,
                "default": 5
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率固定为 2K。",
                "enum": [
                  "2K"
                ],
                "default": "2K"
              },
              "image_urls": {
                "type": "array",
                "description": "首帧和可选尾帧。",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
