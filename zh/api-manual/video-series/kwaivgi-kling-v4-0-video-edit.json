{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling 4.0 视频编辑",
    "description": "Kling 4.0 视频编辑 API 根据文字指令编辑 3–30 秒的源视频，可选参考图和主体，输出 720p 或 1080p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling 4.0 视频编辑",
        "operationId": "submit_kwaivgi_kling_v4_0_video_edit",
        "description": "传 `video_url` 和 `prompt`。不支持 `multi_prompt`、`image_urls`、`reference_video_urls` 和 `aspect_ratio`，传入会返回 400。输入视频会在服务端下载并检测时长（每个最大 100 MB）。每个视频须为 3–30 秒，所有输入视频合计不得超过 30 秒。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `kwaivgi/kling-v4.0/video-edit`。",
                    "example": "kwaivgi/kling-v4.0/video-edit"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "video_url",
                      "prompt"
                    ],
                    "properties": {
                      "video_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/source.mp4",
                        "description": "源视频的公开 HTTP(S) URL，3–30 秒，最大 100 MB。"
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 26000,
                        "example": "Turn the street into a snowy winter evening and keep the people and camera motion unchanged",
                        "description": "编辑指令，去除首尾空白后 1–26,000 个字符，描述要对源视频做的修改。本 ID 不支持 `multi_prompt`。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 30,
                        "description": "输出时长，单位秒（整数，3–30）。省略时与源视频一致，计费按源视频时长向上取整。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率，决定计费档位。"
                      },
                      "reference_image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "maxItems": 10,
                        "description": "最多 10 个公开 HTTP(S) 参考图 URL，在提示词中用 `@Image1`、`@Image2`……引用。"
                      },
                      "kling_elements": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "element_input_urls"
                          ],
                          "properties": {
                            "element_input_urls": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "format": "uri"
                              },
                              "minItems": 2,
                              "maxItems": 4,
                              "description": "2–4 个展示同一主体的公开 HTTP(S) 图片 URL。"
                            }
                          },
                          "additionalProperties": false,
                          "description": "一个图片主体。"
                        },
                        "maxItems": 7,
                        "description": "最多 7 个图片主体（element）。每个 element 包含 2–4 张图片的 `element_input_urls`。本 ID 不支持视频主体。在提示词中按数组顺序用 `@Element1`、`@Element2`……引用。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "restyle": {
                  "summary": "改变风格，保持源视频时长",
                  "value": {
                    "model": "kwaivgi/kling-v4.0/video-edit",
                    "input": {
                      "video_url": "https://example.com/street.mp4",
                      "prompt": "Turn the street into a snowy winter evening and keep the people and camera motion unchanged",
                      "resolution": "720p"
                    }
                  }
                },
                "replace_product": {
                  "summary": "用参考图替换物体，带回调",
                  "value": {
                    "model": "kwaivgi/kling-v4.0/video-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "video_url": "https://example.com/unboxing.mp4",
                      "prompt": "Replace the phone in the hands with the speaker from @Image1, keep lighting and hand motion",
                      "reference_image_urls": [
                        "https://example.com/speaker.png"
                      ],
                      "duration": 10,
                      "resolution": "1080p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
