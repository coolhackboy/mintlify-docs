{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Happy Horse 视频编辑",
    "description": "使用 Happy Horse 根据文本指令和参考图片改造现有视频，引导出新的视觉方向。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Happy Horse 视频编辑",
        "operationId": "submit_alibaba_happyhorse_1_0_video_edit",
        "description": "只发送本工作流列出的字段。包含其他工作流参数的请求会在扣除积分前被拒绝。\n\n输入 URL 字段必须是带主机名、不含内嵌凭证的 HTTP(S) URL。\n\n输入视频时长须在 3 到 60 秒之间。积分等于检测到的源视频时长（最多按 15 秒计）乘以对应分辨率的费率。必须提供非空提示词，最多 2,500 个字符。\n\n提交时扣除积分，任务失败后退还。参考提示词无需使用 character1 或 character2 标记。\n\n需要检测时长的媒体必须是可公开访问的 HTTP(S) 文件，大小不超过 100 MiB。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/happyhorse-1.0/video-edit"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 2500,
                        "minLength": 1,
                        "description": "描述编辑要求的文本提示词。必填，最多 2,500 个字符。"
                      },
                      "reference_image_urls": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "参考图片 URL。"
                        },
                        "description": "可选参考图片，最多 5 张。在提示词中描述所引用的主体；无需特定的角色标记。"
                      },
                      "video_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "视频 URL。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "1080p",
                        "description": "分辨率。"
                      },
                      "audio_setting": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "origin"
                        ],
                        "default": "auto",
                        "description": "音频设置。"
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647,
                        "description": "种子。"
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "description": "启用安全检查。"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "video_url",
                      "prompt"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "alibaba/happyhorse-1.0/video-edit",
                    "input": {
                      "video_url": "https://example.com/video.mp4",
                      "resolution": "1080p",
                      "audio_setting": "auto",
                      "prompt": "Restyle the scene with warm sunset lighting while preserving the original motion."
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "alibaba/happyhorse-1.0/video-edit",
                    "input": {
                      "video_url": "https://example.com/video.mp4",
                      "resolution": "1080p",
                      "audio_setting": "auto",
                      "prompt": "Restyle the scene with warm sunset lighting while preserving the original motion."
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、不支持的档位、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
