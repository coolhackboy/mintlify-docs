{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - PixVerse V6 Max 文生视频",
    "description": "PixVerse V6 Max 文生视频 API 根据提示词生成 1–15 秒、360p 到 1080p 的视频，支持八种宽高比和可选的原生音轨。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "PixVerse V6 Max 文生视频",
        "operationId": "submit_pixverse_v6_max_text_to_video",
        "description": "只传本模型列出的 `input` 字段。其他字段（包括 `image_urls`）都会返回 400。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `pixverse/v6-max/text-to-video`。",
                    "example": "pixverse/v6-max/text-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000,
                        "example": "A street dancer spins under a flickering neon sign in the rain, low-angle tracking shot",
                        "description": "描述场景、动作和镜头。开启 `audio` 时，把对白放在引号中并注明说话人，并描述环境声或音乐。不能为空白，最多 5,000 个字符。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "default": 5,
                        "description": "输出时长，单位为整秒。`null` 视为默认值。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "360p",
                          "540p",
                          "720p",
                          "1080p"
                        ],
                        "default": "540p",
                        "description": "输出分辨率，决定计费档位。`null` 视为默认值。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "16:9",
                          "9:16",
                          "4:3",
                          "3:4",
                          "1:1",
                          "2:3",
                          "3:2",
                          "21:9"
                        ],
                        "description": "输出宽高比。省略时使用上游默认值（16:9）。"
                      },
                      "audio": {
                        "type": "boolean",
                        "default": false,
                        "description": "添加原生音轨（对白、音效、音乐），会改变计费档位。`null` 视为默认值。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "draft": {
                  "summary": "5 秒 540p 无声草稿",
                  "value": {
                    "model": "pixverse/v6-max/text-to-video",
                    "input": {
                      "prompt": "A street dancer spins under a flickering neon sign in the rain, low-angle tracking shot",
                      "duration": 5,
                      "resolution": "540p",
                      "aspect_ratio": "16:9",
                      "audio": false
                    }
                  }
                },
                "dialogue": {
                  "summary": "10 秒竖屏 1080p 对白短片",
                  "value": {
                    "model": "pixverse/v6-max/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Two friends share an umbrella at a bus stop at night. The woman laughs and says: \"You forgot yours again?\" Rain patters on the umbrella, distant traffic.",
                      "duration": 10,
                      "resolution": "1080p",
                      "aspect_ratio": "9:16",
                      "audio": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
