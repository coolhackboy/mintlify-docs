{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Wan 2.6 文生视频",
    "description": "使用 Wan 2.6 将文字描述的场景转为视频，支持多镜头，输出最长 15 秒、最高 1080p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Wan 2.6 文生视频",
        "operationId": "submit_alibaba_wan_2_6_text_to_video",
        "description": "只发送本工作流列出的字段。包含其他工作流参数的请求会在扣除积分前被拒绝。\n\n如果提供 prompt，则不能为空。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/wan-2.6/text-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "description": "生成参数",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "视频生成的文本提示词",
                        "maxLength": 5000,
                        "minLength": 1
                      },
                      "duration": {
                        "type": "integer",
                        "description": "视频时长（秒）（文生视频和图生视频支持 15 秒）",
                        "enum": [
                          5,
                          10,
                          15
                        ],
                        "default": 5
                      },
                      "resolution": {
                        "type": "string",
                        "description": "输出视频分辨率",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p"
                      },
                      "multi_shots": {
                        "type": "boolean",
                        "description": "启用多镜头构图（为 false 时为单个连续镜头）"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "alibaba/wan-2.6/text-to-video",
                    "input": {
                      "duration": 5,
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "alibaba/wan-2.6/text-to-video",
                    "input": {
                      "duration": 5,
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、不支持的档位、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
