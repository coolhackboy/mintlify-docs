{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedance 1.0 Pro 图生视频",
    "description": "使用 Seedance 1.0 Pro 将静态图片转为 5 秒或 10 秒的视频，用文本引导场景和运动。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Seedance 1.0 Pro 图生视频",
        "operationId": "submit_bytedance_seedance_v1_pro_image_to_video",
        "description": "按文档说明的输入类型和取值传参。prompt 必须是字符串，去除首尾空白后为 1–10,000 个 Unicode 字符。duration 必须是数值 5 或 10，字符串和小数会被拒绝。resolution 必须是 720p 或 1080p。图片输入要求恰好一个带主机名的 HTTP(S) URL，不能内嵌凭证或包含空白；不支持 Base64。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "bytedance/seedance/v1/pro/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "description": "生成所需的输入参数",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "必填字符串；先去除首尾空白，再校验长度为 1–10,000 个 Unicode 字符。",
                        "maxLength": 10000,
                        "example": "Animate this exact outdoor loom scene in one continuous five-second shot. The same Ghanaian weaver throws the wooden shuttle once through the open shed, then beats the weft so the navy-and-gold cloth settles with a slight sag. Preserve her face, hair, clothing, loom geometry, textile pattern, mango-tree background, and camera framing. Very slow gentle lateral camera drift. Tactile wood and cloth physics. No extra people, no cuts, no lettering, no logos, no brands, no advertising, no watermark.",
                        "minLength": 1
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "maxItems": 1,
                        "description": "恰好一个带主机名的 HTTP(S) 图片 URL，不能内嵌凭证或包含空白。Base64 和裸字符串会被拒绝。",
                        "example": [
                          "https://cdn.vidgo.ai/apis/models/bytedance/seedance/v1/pro/image-to-video/v1/01/input.png"
                        ],
                        "minItems": 1
                      },
                      "resolution": {
                        "type": "string",
                        "description": "仅支持 720p 或 1080p。仅在省略时默认为 720p；别名、null 和空字符串会被拒绝。",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "example": "720p",
                        "default": "720p"
                      },
                      "duration": {
                        "type": "integer",
                        "description": "数值整数 5 或 10 秒。仅在省略时默认为 5；字符串、布尔值、null 和小数会被拒绝。",
                        "enum": [
                          5,
                          10
                        ],
                        "example": 5,
                        "default": 5
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选，接收任务完成通知的公开 HTTP(S) 地址，建议使用 HTTPS。省略、传 null 或传空字符串即不启用回调。"
                  }
                },
                "description": "model 和可选的 callback_url 放在根级。不支持的 input 字段会被拒绝。默认值仅对省略的字段生效；null 和空的 input 值会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "肯特布织机梭子",
                  "value": {
                    "model": "bytedance/seedance/v1/pro/image-to-video",
                    "input": {
                      "prompt": "Animate this exact outdoor loom scene in one continuous five-second shot. The same Ghanaian weaver throws the wooden shuttle once through the open shed, then beats the weft so the navy-and-gold cloth settles with a slight sag. Preserve her face, hair, clothing, loom geometry, textile pattern, mango-tree background, and camera framing. Very slow gentle lateral camera drift. Tactile wood and cloth physics. No extra people, no cuts, no lettering, no logos, no brands, no advertising, no watermark.",
                      "resolution": "720p",
                      "duration": 5,
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedance/v1/pro/image-to-video/v1/01/input.png"
                      ]
                    }
                  }
                },
                "callback": {
                  "summary": "肯特布织机梭子（含完成回调）",
                  "value": {
                    "model": "bytedance/seedance/v1/pro/image-to-video",
                    "input": {
                      "prompt": "Animate this exact outdoor loom scene in one continuous five-second shot. The same Ghanaian weaver throws the wooden shuttle once through the open shed, then beats the weft so the navy-and-gold cloth settles with a slight sag. Preserve her face, hair, clothing, loom geometry, textile pattern, mango-tree background, and camera framing. Very slow gentle lateral camera drift. Tactile wood and cloth physics. No extra people, no cuts, no lettering, no logos, no brands, no advertising, no watermark.",
                      "resolution": "720p",
                      "duration": 5,
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedance/v1/pro/image-to-video/v1/01/input.png"
                      ]
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
