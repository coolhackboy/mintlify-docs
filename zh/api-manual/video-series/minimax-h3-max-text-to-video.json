{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax H3 Max 文生视频",
    "description": "根据文本提示词生成视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 MiniMax H3 Max 文生视频任务",
        "operationId": "submitMinimaxH3MaxTextToVideoTask",
        "tags": [
          "MiniMax H3 Max Text to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "默认文生视频",
                  "value": {
                    "model": "minimax/h3-max/text-to-video",
                    "input": {
                      "prompt": "A cinematic aerial view of a coastal city at sunrise"
                    }
                  }
                },
                "custom": {
                  "summary": "自定义输出设置",
                  "value": {
                    "model": "minimax/h3-max/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A coastal city at sunset",
                      "duration": 10,
                      "resolution": "1080p",
                      "aspect_ratio": "9:16",
                      "enable_safety_checker": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1787970600-abcd1234",
                    "status": "not_started",
                    "created_time": "2026-08-29T10:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax/h3-max/text-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000,
                "description": "描述目标视频的非空提示词。\n\n必须包含至少一个非空白字符。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 15,
                "default": 5,
                "description": "请求的输出时长（秒）。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "768p",
                  "1080p"
                ],
                "default": "768p",
                "description": "输出分辨率。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "设为 false 可关闭安全检查。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "16:9"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
