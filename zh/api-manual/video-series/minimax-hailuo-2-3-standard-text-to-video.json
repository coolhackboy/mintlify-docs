{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Hailuo 2.3 文生视频",
    "description": "使用 Hailuo 2.3 Standard 生成短视频场景，输出 768p，可对书面场景构思进行可选的提示词优化。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Hailuo 2.3 文生视频",
        "operationId": "submit_minimax_hailuo_2_3_standard_text_to_video",
        "description": "只发送该工作流程列出的字段。其他工作流程的参数会在扣除积分前被拒绝。\n\nprompt 必填且不能为空。\n\n该 ID 将 `resolution` 固定为 `768p`。\n\n不做类型转换：数字形式的提示词、字符串形式的布尔值和小数时长会被拒绝。\n\n计费取决于视频时长（`duration`），使用 Standard 模型档位。该接口将输出分辨率固定为 `768p`。提示词优化（`prompt_optimizer`）不影响费用。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "minimax/hailuo-2.3/standard/text-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 1,
                        "description": "必填的非空字符串，校验前会去除首尾空白。最多 5,000 个 Unicode 字符。"
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          6,
                          10
                        ],
                        "default": 6,
                        "description": "输出时长（秒）。6 或 10；默认为 6。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "768p"
                        ],
                        "default": "768p",
                        "description": "该接口固定为 768p。"
                      },
                      "prompt_optimizer": {
                        "type": "boolean",
                        "description": "可选布尔值，未指定默认值。不使用时省略。不额外收费。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流程",
                  "value": {
                    "model": "minimax/hailuo-2.3/standard/text-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 6,
                      "resolution": "768p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "minimax/hailuo-2.3/standard/text-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 6,
                      "resolution": "768p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
