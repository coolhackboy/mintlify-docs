{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling 1.6 文生视频",
    "description": "使用 Kling 1.6 Standard 创建短视频场景，通过文本描述和负面提示词塑造动作与外观。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling 1.6 文生视频",
        "operationId": "submit_kwaivgi_kling_video_v1_6_standard_text_to_video",
        "description": "只发送该工作流程列出的字段。其他工作流程的参数会在扣除积分前被拒绝。\n\n提供 prompt 时不能为空。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "kwaivgi/kling-video/v1.6/standard/text-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "duration"
                    ],
                    "description": "生成参数。",
                    "additionalProperties": false,
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "必填的非空字符串，去除首尾空白后最多 2,500 个 Unicode 字符。",
                        "maxLength": 2500,
                        "example": "A cinematic video scene",
                        "minLength": 1
                      },
                      "duration": {
                        "type": "integer",
                        "description": "必填整数：5 或 10 秒。无 API 默认值。",
                        "enum": [
                          5,
                          10
                        ],
                        "example": 5
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "description": "可选：1:1、16:9 或 9:16。无 API 默认值。",
                        "enum": [
                          "1:1",
                          "16:9",
                          "9:16"
                        ],
                        "example": "16:9"
                      },
                      "negative_prompt": {
                        "type": "string",
                        "description": "可选字符串，最多 2,500 个 Unicode 字符。",
                        "maxLength": 2500,
                        "example": "blur, low quality, artifacts"
                      },
                      "cfg_scale": {
                        "type": "number",
                        "description": "可选，0 到 1 之间的有限数值。无 API 默认值。",
                        "minimum": 0,
                        "maximum": 1,
                        "example": 0.5
                      }
                    }
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "文生视频",
                  "value": {
                    "model": "kwaivgi/kling-video/v1.6/standard/text-to-video",
                    "input": {
                      "prompt": "A quiet forest in morning light, with a slow camera pan.",
                      "duration": 5
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "kwaivgi/kling-video/v1.6/standard/text-to-video",
                    "input": {
                      "prompt": "A quiet forest in morning light, with a slow camera pan.",
                      "duration": 5
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
