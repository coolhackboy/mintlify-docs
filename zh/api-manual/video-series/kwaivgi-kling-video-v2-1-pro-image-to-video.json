{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling 2.1 Pro 图生视频",
    "description": "Kling 2.1 Pro 图生视频，首帧必填，尾帧可选。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling 2.1 Pro 图生视频",
        "operationId": "submit_kwaivgi_kling_video_v2_1_pro_image_to_video",
        "description": "Kling 2.1 Pro 图生视频，首帧必填，尾帧可选。不支持的 input 字段会在扣除积分前被拒绝。按视频计费，取决于所选模型档位（Standard 或 Pro）和视频时长（`duration`）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "kwaivgi/kling-video/v2.1/pro/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "start_image_url"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 1,
                        "description": "必填的非空字符串，去除首尾空白后最多 5,000 个 Unicode 字符。"
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          5,
                          10
                        ],
                        "default": 5,
                        "description": "可选整数：5 或 10 秒。省略时默认为 5。字符串、布尔值、null 和小数时长会被拒绝。"
                      },
                      "start_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "必填的首帧公开 HTTP(S) URL，需包含主机名，且不含凭据或空白字符。空 URL 和 null 会被拒绝。"
                      },
                      "end_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "可选的尾帧公开 HTTP(S) URL，需包含主机名，且不含凭据或空白字符。不使用的可选字段请省略；空 URL 和 null 会被拒绝。"
                      },
                      "negative_prompt": {
                        "type": "string",
                        "description": "负面提示词。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流程",
                  "value": {
                    "model": "kwaivgi/kling-video/v2.1/pro/image-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "start_image_url": "https://example.com/image.png",
                      "duration": 5
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "kwaivgi/kling-video/v2.1/pro/image-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "start_image_url": "https://example.com/image.png",
                      "duration": 5
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "with_end_frame": {
                  "summary": "Pro 带可选尾帧",
                  "value": {
                    "model": "kwaivgi/kling-video/v2.1/pro/image-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "start_image_url": "https://example.com/image.png",
                      "duration": 5,
                      "end_image_url": "https://example.com/end-frame.png"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
