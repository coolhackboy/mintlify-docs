{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedance 2.5 文生视频",
    "description": "通过 Vidgo 统一生成 API 调用 Seedance 2.5 文生视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Seedance 2.5 文生视频任务",
        "operationId": "submitSeedance25TextToVideoTask",
        "tags": [
          "Seedance 2.5 Text to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default": {
                  "summary": "Seedance 2.5 文生视频",
                  "value": {
                    "model": "seedance-2.5/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic scene with natural lighting and coherent motion",
                      "duration": 5,
                      "resolution": "480p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "seedance-2.5/text-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "duration",
              "resolution"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述目标视频的提示词。",
                "minLength": 1,
                "maxLength": 20000
              },
              "duration": {
                "type": "integer",
                "description": "输出时长（秒）。",
                "minimum": 4,
                "maximum": 30
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率。",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ]
              },
              "aspect_ratio": {
                "type": "string",
                "description": "输出宽高比。图生视频传入时仅接受 auto。",
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "generate_audio": {
                "type": "boolean",
                "description": "是否生成音轨。"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
