{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 Max 文生视频",
    "description": "FLUX 3 Max 文生视频 API 根据文本提示词生成 5–20 秒、720p 或 1080p 的视频，支持八种宽高比和可选的原生音频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "FLUX 3 Max 文生视频",
        "operationId": "submit_blackforestlabs_flux_3_max_text_to_video",
        "description": "只传本模型列出的 `input` 字段。其他字段（包括 `image_urls`、`keyframes`）都会返回 400。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `blackforestlabs/flux-3-max/text-to-video`。",
                    "example": "blackforestlabs/flux-3-max/text-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "example": "A paper boat drifts down a rain-soaked city gutter at dusk, neon reflections rippling, slow tracking shot",
                        "description": "描述场景、主体动作、镜头运动；开启 `sound` 时也可以描述想要的声音或对白。不能为空白。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20,
                        "default": 5,
                        "description": "输出时长，单位秒（整数）。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率，决定计费档位。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "2:1",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "9:16"
                        ],
                        "default": "auto",
                        "description": "输出宽高比。`auto` 由模型决定：纯文本时为 16:9，有输入图片时跟随第一张图片的比例。"
                      },
                      "sound": {
                        "type": "boolean",
                        "default": true,
                        "description": "在同一次生成中输出原生音频。设为 `false` 生成无声视频。不影响价格。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "5 秒 720p 带音频短片",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/text-to-video",
                    "input": {
                      "prompt": "A paper boat drifts down a rain-soaked city gutter at dusk, neon reflections rippling, slow tracking shot, soft rain and distant traffic",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "16:9",
                      "sound": true
                    }
                  }
                },
                "vertical_silent": {
                  "summary": "15 秒竖屏 1080p 无声短片",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A barista pours latte art in slow motion, overhead close-up, warm cafe light",
                      "duration": 15,
                      "resolution": "1080p",
                      "aspect_ratio": "9:16",
                      "sound": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
