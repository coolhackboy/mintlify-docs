{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling 3.0 Turbo Standard 图生视频",
    "description": "使用 Kling 3.0 Turbo Standard 让参考图动起来，通过文本和分镜提示词引导视频序列。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling 3.0 Turbo Standard 图生视频",
        "operationId": "submit_kwaivgi_kling_v3_turbo_std_image_to_video",
        "description": "只发送该工作流程列出的字段。其他工作流程的参数会在扣除积分前被拒绝。\n\n空白的可选提示词视为省略。输入 URL 字段要求使用带主机名且不含内嵌凭据的 HTTP(S) URL。\n\n输出宽高比跟随输入图像；aspect_ratio 对该接口无效。\n\nprompt 可选，且不能与 multi_prompt 同时使用。提供一到六个镜头，每个镜头包含非空 prompt 和可选的整数 duration（一到十五秒，默认五秒）。镜头总时长不得超过十五秒。显式指定的顶层 duration 必须为三到十五秒，且等于镜头总时长。省略时使用镜头总时长，包括一秒或两秒的总时长。不使用 multi_prompt 时，省略的 duration 默认为五秒。提供 multi_prompt 时按镜头总时长计费。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "kwaivgi/kling-v3-turbo-std/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 2500,
                        "minLength": 1,
                        "description": "提示词。"
                      },
                      "multi_prompt": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "required": [
                            "prompt"
                          ],
                          "properties": {
                            "prompt": {
                              "type": "string",
                              "maxLength": 2500,
                              "description": "提示词。"
                            },
                            "duration": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 15,
                              "default": 5,
                              "description": "镜头时长 1 到 15 秒；省略时默认为 5。"
                            }
                          },
                          "additionalProperties": false,
                          "description": "多镜头提示词。"
                        },
                        "description": "多镜头提示词。"
                      },
                      "image_urls": {
                        "type": "array",
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图像 URL。"
                        },
                        "minItems": 1,
                        "description": "图像 URL。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 15,
                        "default": 5,
                        "description": "显式指定的 duration 必须为 3–15 秒。使用 multi_prompt 时必须等于各镜头时长之和。省略 duration 则使用镜头总时长（1–15 秒）；不使用 multi_prompt 时默认为 5 秒。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "description": "图生视频模式下忽略此参数；宽高比由输入图像决定。"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "image_urls"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流程",
                  "value": {
                    "model": "kwaivgi/kling-v3-turbo-std/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "duration": 5
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "kwaivgi/kling-v3-turbo-std/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "duration": 5
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "multi_shot": {
                  "summary": "两个镜头，省略总时长（10 秒）",
                  "value": {
                    "model": "kwaivgi/kling-v3-turbo-std/image-to-video",
                    "input": {
                      "multi_prompt": [
                        {
                          "prompt": "A wide shot of a forest.",
                          "duration": 5
                        },
                        {
                          "prompt": "The camera moves toward a sunlit tree.",
                          "duration": 5
                        }
                      ],
                      "image_urls": [
                        "https://example.com/image.png"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
