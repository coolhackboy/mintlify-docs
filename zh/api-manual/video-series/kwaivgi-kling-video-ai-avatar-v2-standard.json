{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling Avatar 2.0 Standard",
    "description": "使用 Kling Avatar 2.0 Standard 创建说话的数字人，结合角色图片与音频表演，可选文本引导。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling Avatar 2.0 Standard",
        "operationId": "submit_kwaivgi_kling_video_ai_avatar_v2_standard",
        "description": "只发送该工作流程列出的字段。其他工作流程的参数会在扣除积分前被拒绝。\n\n可选的提示词字符串会去除首尾空白；null、空字符串和仅含空白的提示词视为省略。恰好提供一张图片，可以是公开的 HTTP(S) URL、图片 Data URI 或原始 Base64。音频需要使用不含内嵌凭据的公开 HTTP(S) URL。Base64 转换和媒体校验在扣除积分前完成。\n\n驱动音频时长必须在两秒到六十秒之间。用量按检测到的时长计算，向上取整到整秒。\n\n驱动音频必须是可公开访问的 HTTP(S) 文件，大小不超过 5 MiB（5,242,880 字节）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。",
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "kwaivgi/kling-video/ai-avatar/v2/standard"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "audio_url",
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "description": "图像 URL。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "恰好一张图片：公开的 HTTP(S) URL、图片 Data URI 或原始 Base64。Base64 会在提交前转换为 URL。"
                      },
                      "audio_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "公开的 HTTP(S) 驱动音频 URL。时长必须在 2–60 秒之间（含端点）；文件大小不得超过 5 MiB。"
                      },
                      "prompt": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 2500,
                        "description": "可选提示词，最多 2500 个字符。首尾空白会被去除；null、空字符串或仅含空白的值视为省略。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流程",
                  "value": {
                    "model": "kwaivgi/kling-video/ai-avatar/v2/standard",
                    "input": {
                      "audio_url": "https://example.com/audio.mp3",
                      "image_urls": [
                        "https://example.com/image.png"
                      ]
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "kwaivgi/kling-video/ai-avatar/v2/standard",
                    "input": {
                      "audio_url": "https://example.com/audio.mp3",
                      "image_urls": [
                        "https://example.com/image.png"
                      ]
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
