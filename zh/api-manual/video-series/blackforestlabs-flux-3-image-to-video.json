{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 图生视频",
    "description": "使用 FLUX 3 让静态图片动起来，用文本指引场景，可选生成声音，输出最高 1080p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "FLUX 3 图生视频",
        "operationId": "submit_blackforestlabs_flux_3_image_to_video",
        "description": "只传本工作流列出的字段。其他工作流的参数会在扣除积分前被拒绝。\n\n传入 prompt 时不能为空白。输入的 URL 字段必须是带主机名的 HTTP(S) URL，且不能内嵌凭证。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "blackforestlabs/flux-3/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "description": "提示词。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20,
                        "default": 5,
                        "description": "时长。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "分辨率。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "2:1",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "9:16"
                        ],
                        "default": "auto",
                        "description": "宽高比。"
                      },
                      "sound": {
                        "type": "boolean",
                        "default": true,
                        "description": "声音。"
                      },
                      "image_urls": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图片 URL。"
                        },
                        "description": "图片 URL。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选，接收任务完成通知的公开 HTTP(S) 地址，建议使用 HTTPS。省略、传 null 或传空字符串即不启用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "blackforestlabs/flux-3/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "auto",
                      "sound": true
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "blackforestlabs/flux-3/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "auto",
                      "sound": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
