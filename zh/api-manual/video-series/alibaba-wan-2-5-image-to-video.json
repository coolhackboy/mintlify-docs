{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Wan 2.5 图生视频",
    "description": "使用 Wan 2.5 将参考图片生成 5 或 10 秒的视频，支持音频输入，视频输出最高 1080p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "提交 Wan 2.5 图生视频任务",
        "operationId": "submit_alibaba_wan_2_5_image_to_video",
        "description": "只发送本工作流列出的字段。包含其他工作流参数的请求会在扣除积分前被拒绝。\n\n如果提供 prompt，则不能为空。输入 URL 字段必须是带主机名、不含内嵌凭证的 HTTP(S) URL。\n\nduration 可设为 5 或 10 秒。省略时默认 5 秒。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/wan-2.5/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 1500,
                        "minLength": 1,
                        "description": "描述主体、场景和运动。去除首尾空白后为 1–1500 个字符。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "可公开访问的 HTTP(S) 图片 URL。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "只能提供一个可公开访问的 HTTP(S) 图片 URL。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "480p",
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率：480p、720p 或 1080p。默认：720p。"
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          5,
                          10
                        ],
                        "default": 5,
                        "description": "视频时长：5 或 10 秒。默认：5。"
                      },
                      "audio": {
                        "type": "string",
                        "description": "可选的音频文件 URL，为视频提供一段录音。",
                        "example": "https://example.com/audio.mp3"
                      },
                      "negative_prompt": {
                        "type": "string",
                        "description": "可选，描述场景中要排除的元素。"
                      },
                      "seed": {
                        "type": "integer",
                        "description": "可选的整数随机种子，用于复用生成设置。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和可选的 callback_url 放在请求根级，生成参数放在 input 内。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "alibaba/wan-2.5/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p",
                      "duration": 5
                    }
                  }
                },
                "callback": {
                  "summary": "10 秒视频并接收完成回调",
                  "value": {
                    "model": "alibaba/wan-2.5/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "720p",
                      "duration": 10
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入校验、媒体访问或账户余额错误",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
