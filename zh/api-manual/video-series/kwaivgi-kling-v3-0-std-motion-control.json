{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Kling 3.0 Standard 动作控制",
    "description": "使用 Kling 3.0 Standard 将参考视频中的动作迁移到图片主体上，支持朝向控制，输出 720p。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Kling 3.0 Standard 动作控制",
        "operationId": "submit_kwaivgi_kling_v3_0_std_motion_control",
        "description": "只发送该工作流程列出的字段。其他工作流程的参数会在扣除积分前被拒绝。\n\n空白的可选提示词视为省略。输入 URL 字段要求使用带主机名且不含内嵌凭据的 HTTP(S) URL。\n\n该 ID 将 `resolution` 固定为 `720p`。\n\n输入视频至少三秒。使用 image 朝向时最长十秒，使用 video 朝向时最长三十秒。积分等于检测到的时长乘以该接口费率，结果向上取整为整数。null、空字符串和仅含空白的提示词视为省略；非空提示词会去除首尾空白，最多 2,500 个字符。\n\n最多允许一个面部元素，且仅限 video 朝向；需提供一张正面图像和一到三张参考图。\n\n用于检测时长的媒体必须是可公开访问的 HTTP(S) 文件，大小不超过 100 MiB。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "kwaivgi/kling-v3.0-std/motion-control"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "character_orientation",
                      "image_urls",
                      "video_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 2500,
                        "minLength": 0,
                        "nullable": true,
                        "description": "可选。null、空字符串和仅含空白的提示词视为省略。非空提示词会去除首尾空白，最多 2,500 个字符。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "图像 URL。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "图像 URL。"
                      },
                      "video_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "视频 URL。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "视频 URL。"
                      },
                      "character_orientation": {
                        "type": "string",
                        "enum": [
                          "image",
                          "video"
                        ],
                        "description": "角色朝向。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率"
                      },
                      "kling_elements": {
                        "type": "array",
                        "maxItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "frontal_image_url",
                            "reference_image_urls"
                          ],
                          "properties": {
                            "frontal_image_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "正面图像 URL。"
                            },
                            "reference_image_urls": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "format": "uri",
                                "description": "参考图 URL。"
                              },
                              "minItems": 1,
                              "maxItems": 3,
                              "description": "参考图 URL。"
                            }
                          },
                          "additionalProperties": false,
                          "description": "Kling 元素。"
                        },
                        "description": "Kling 元素。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 接口，用于接收任务完成通知。建议使用 HTTPS。省略、传 null 或空字符串即可禁用回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流程",
                  "value": {
                    "model": "kwaivgi/kling-v3.0-std/motion-control",
                    "input": {
                      "character_orientation": "image",
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "video_urls": [
                        "https://example.com/video.mp4"
                      ],
                      "resolution": "720p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "kwaivgi/kling-v3.0-std/motion-control",
                    "input": {
                      "character_orientation": "image",
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "video_urls": [
                        "https://example.com/video.mp4"
                      ],
                      "resolution": "720p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、档位不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭据无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
