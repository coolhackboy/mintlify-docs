                },
                "example": "Request timeout"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "使用 VIDGO_API_KEY。"
      }
    }
  }
}
