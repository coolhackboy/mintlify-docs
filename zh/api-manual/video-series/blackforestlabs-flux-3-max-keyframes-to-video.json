{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 Max 关键帧生视频",
    "description": "FLUX 3 Max 关键帧生视频 API 通过 frame_index 把 1–10 张图片放到 24 fps 时间轴上，生成它们之间 5–20 秒的连贯运动。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "FLUX 3 Max 关键帧生视频",
        "operationId": "submit_blackforestlabs_flux_3_max_keyframes_to_video",
        "description": "只传本模型列出的 `input` 字段。其他字段（包括 `image_urls`）都会返回 400。每个关键帧需要一个公开 HTTP(S) 的 `image_url`，以及取值在 0 到 `duration × 24` 之间且不重复的 `frame_index`。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `blackforestlabs/flux-3-max/keyframes-to-video`。",
                    "example": "blackforestlabs/flux-3-max/keyframes-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "keyframes",
                      "prompt"
                    ],
                    "properties": {
                      "keyframes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "image_url",
                            "frame_index"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "关键帧图片的公开 HTTP(S) URL（PNG、JPEG 或 WebP）。"
                            },
                            "frame_index": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 480,
                              "description": "在 24 fps 时间轴上的帧位置，取值 `0` 到 `duration × 24`（例如 5 秒视频为 0–120）。"
                            }
                          },
                          "additionalProperties": false,
                          "description": "一个关键帧。"
                        },
                        "minItems": 1,
                        "maxItems": 10,
                        "description": "1–10 个关键帧。每个对象只能包含 `image_url` 和 `frame_index`，帧序号不能重复。"
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "example": "A seed sprouts, grows into a sapling and blossoms into a cherry tree, time-lapse, fixed camera",
                        "description": "描述关键帧之间的运动与过渡、镜头运动，以及开启 `sound` 时的声音。不能为空白。"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20,
                        "default": 5,
                        "description": "输出时长，单位秒（整数）。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "输出分辨率，决定计费档位。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "2:1",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "9:16"
                        ],
                        "default": "auto",
                        "description": "输出宽高比。`auto` 由模型决定：纯文本时为 16:9，有输入图片时跟随第一张图片的比例。"
                      },
                      "sound": {
                        "type": "boolean",
                        "default": true,
                        "description": "在同一次生成中输出原生音频。设为 `false` 生成无声视频。不影响价格。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "three_keyframes": {
                  "summary": "5 秒内三个关键帧",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/keyframes-to-video",
                    "input": {
                      "keyframes": [
                        {
                          "image_url": "https://example.com/seed.png",
                          "frame_index": 0
                        },
                        {
                          "image_url": "https://example.com/sapling.png",
                          "frame_index": 60
                        },
                        {
                          "image_url": "https://example.com/blossom.png",
                          "frame_index": 120
                        }
                      ],
                      "prompt": "A seed sprouts, grows into a sapling and blossoms into a cherry tree, time-lapse, fixed camera",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "auto",
                      "sound": true
                    }
                  }
                },
                "storyboard": {
                  "summary": "10 秒 1080p 分镜，带回调",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/keyframes-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "keyframes": [
                        {
                          "image_url": "https://example.com/shot-1.png",
                          "frame_index": 0
                        },
                        {
                          "image_url": "https://example.com/shot-2.png",
                          "frame_index": 96
                        },
                        {
                          "image_url": "https://example.com/shot-3.png",
                          "frame_index": 168
                        },
                        {
                          "image_url": "https://example.com/shot-4.png",
                          "frame_index": 240
                        }
                      ],
                      "prompt": "A courier cycles through a misty city at dawn, crosses a bridge and arrives at a lit doorway, smooth tracking shots",
                      "duration": 10,
                      "resolution": "1080p",
                      "aspect_ratio": "21:9",
                      "sound": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "凭证无效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
