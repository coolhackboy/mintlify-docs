{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Wan Animate Replace",
    "description": "使用 Wan Animate Replace，将源视频中的角色替换为参考图片中的角色。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Wan Animate Replace",
        "operationId": "submit_alibaba_wan_v2_2_14b_animate_replace",
        "description": "使用 Wan Animate Replace，将源视频中的角色替换为参考图片中的角色。\n\nmodel 和可选的 callback_url 放在请求根级。input 对象只接受 video_url、image_urls 和 resolution。不支持的 input 字段会在扣除积分前被拒绝。\n\n输入 URL 必须使用 HTTP(S)，带主机名，且不含内嵌凭证或空白字符。源视频必须可公开访问，整个文件不超过 100 MiB（104,857,600 字节），且时长大于零。Vidgo 会在创建任务前校验请求并检查源视频。任务创建成功后返回 task_id。可查询任务状态或提供 callback_url 来获取结果。\n\n计费取决于所选分辨率和向上取整到整秒的源视频时长。Move 和 Replace 使用相同费率。时长 5.1 秒的源视频按 6 秒计费。视频检测失败的请求会在扣除积分前被拒绝。有效请求提交生成时扣除积分，任务失败后退还。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/wan/v2.2-14b/animate/replace"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "video_url"
                    ],
                    "properties": {
                      "video_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "必填字符串。包含要替换角色的源视频。使用可公开访问、带主机名、不含内嵌凭证或空白字符的 HTTP(S) URL。整个视频文件不超过 100 MiB（104,857,600 字节），且时长大于零。Vidgo 会检测源视频时长用于计费。"
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "可公开访问的 HTTP(S) 图片 URL，带主机名，不含内嵌凭证或空白字符。"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "必填数组，只包含一个可公开访问的 HTTP(S) 图片 URL，即包含替换角色的参考图片。传入单个 URL 字符串而非数组、空数组、多个 URL 以及 Base64 图片都会被拒绝。URL 必须带主机名，且不含内嵌凭证或空白字符。"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "480p",
                          "580p",
                          "720p"
                        ],
                        "default": "480p",
                        "description": "可选字符串：480p、580p 或 720p。仅在省略时默认 480p。null、空字符串、其他取值以及带首尾空白的取值都会被拒绝。所选分辨率决定每秒源视频的计费费率。计算总量前，源视频时长会向上取整到整秒。"
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                },
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。"
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "alibaba/wan/v2.2-14b/animate/replace",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "video_url": "https://example.com/video.mp4",
                      "resolution": "480p"
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "alibaba/wan/v2.2-14b/animate/replace",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "video_url": "https://example.com/video.mp4",
                      "resolution": "480p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务创建成功。使用返回的 task_id 查询任务状态并获取结果。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入参数无效或不受支持、源视频无法访问、视频超过 100 MiB 或时长非正数或无法读取，或积分不足。",
            "content": {
