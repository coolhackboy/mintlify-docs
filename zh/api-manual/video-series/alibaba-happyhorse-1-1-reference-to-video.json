{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Happy Horse 1.1 参考生视频",
    "description": "通过 Vidgo 统一提交 API 使用 Happy Horse 1.1 参考生视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Happy Horse 1.1 参考生视频",
        "operationId": "submit_alibaba_happyhorse_1_1_reference_to_video",
        "description": "只发送本工作流列出的字段。包含其他工作流参数的请求会在扣除积分前被拒绝。\n\n提示词会去除首尾空白，最多 2,500 个 Unicode 字符。必须提供非空提示词。图片数组接受公开的 HTTP(S) URL、图片 Data URI 或原始 Base64；转换会在扣除积分前完成。\n\n时长可选 3 到 15 秒的整数（默认 5），分辨率可选 720p 或 1080p（默认 1080p）。用量等于请求的输出秒数乘以所选分辨率的费率。当前价格见[定价](https://vidgo.ai/apis/api-pricing)。\n\n在 reference_image_urls 中按顺序提供 1 到 9 张图片。\n\n支持的宽高比：21:9、16:9、4:3、1:1、3:4、4:5、5:4、9:16 和 9:21。默认：16:9。\n\n`duration` 和 `seed` 也接受整数字符串，如 `\"5\"`；小数（如 `5.0`）和小数字符串（如 `\"5.0\"`）会被拒绝。null 或空值会使用默认时长或省略种子。支持的布尔字段也接受 `0`/`1`，以及不区分大小写的字符串 `true`/`false`、`1`/`0`、`yes`/`no`、`y`/`n` 和 `on`/`off`；null 表示省略该字段。首尾空白会被去除，分辨率取值不区分大小写。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "description": "model 和 callback_url 放在根级。未知的根级字段会被忽略；不支持的 input 字段会被拒绝。",
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/happyhorse-1.1/reference-to-video"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 2500,
                        "minLength": 1,
                        "description": "去除首尾空白。最多 2,500 个 Unicode 字符。文生视频和参考生视频必填；图生视频可选。"
                      },
                      "reference_image_urls": {
                        "type": "array",
                        "maxItems": 9,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "description": "参考图片 URL。"
                        },
                        "minItems": 1,
                        "description": "1 到 9 张有序参考图片。接受公开的 HTTP(S) URL、图片 Data URI 或原始 Base64。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "21:9",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "4:5",
                          "5:4",
                          "9:16",
                          "9:21"
                        ],
                        "default": "16:9",
                        "description": "文生视频和参考生视频的输出宽高比"
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "1080p",
                        "description": "输出分辨率"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 15,
                        "default": 5,
                        "description": "输出时长（秒）。积分按时长和所选分辨率计算。"
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647,
                        "description": "可选的随机种子，用于可复现的生成"
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "description": "对输入和输出启用内容审核"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "prompt",
                      "reference_image_urls"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，用于接收任务完成通知。建议使用 HTTPS。省略、设为 null 或空字符串即不发送回调。"
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "基础工作流",
                  "value": {
                    "model": "alibaba/happyhorse-1.1/reference-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "aspect_ratio": "16:9",
                      "resolution": "1080p",
                      "duration": 5,
                      "reference_image_urls": [
                        "https://example.com/image.png"
                      ]
                    }
                  }
                },
                "callback": {
                  "summary": "接收完成回调",
                  "value": {
                    "model": "alibaba/happyhorse-1.1/reference-to-video",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "aspect_ratio": "16:9",
                      "resolution": "1080p",
                      "duration": 5,
                      "reference_image_urls": [
                        "https://example.com/image.png"
                      ]
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、不支持的档位、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
