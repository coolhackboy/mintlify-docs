{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - OmniHuman 2.0 音频生视频",
    "description": "OmniHuman 2.0 音频生视频 API 用一段 4–300 秒的 WAV 或 MP3 音频驱动一张角色图片，生成口型同步的 720p 视频，可选提示词。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "OmniHuman 2.0 音频生视频",
        "operationId": "submit_bytedance_omnihuman_2_0_audio_to_video",
        "description": "`input` 中只传 `image_urls`、`audio_url` 和可选的 `prompt`。其他字段（包括 `duration`、`resolution`、`aspect_ratio`）都会返回 400。提交时会下载并检测音频：必须是 WAV 或 MP3，不超过 15 MB，时长 4–300 秒。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "模型 ID，填 `bytedance/omnihuman-2.0/audio-to-video`。",
                    "example": "bytedance/omnihuman-2.0/audio-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "可选的公开 HTTP(S) 地址，任务变为 `finished` 或 `failed` 时会收到 POST 请求。建议使用 HTTPS。省略、传 `null` 或空字符串即不发送回调。",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "audio_url"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/presenter.png"
                        ],
                        "description": "恰好一个公开 HTTP(S) 角色图片 URL：真人、动物，或卡通、3D、风格化角色，也可以是多人画面。构图跟随这张图片。"
                      },
                      "audio_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/voiceover.mp3",
                        "description": "驱动音频的公开 HTTP(S) URL：WAV 或 MP3 文件，不超过 15 MB，时长 4–300 秒。视频时长跟随音频。"
                      },
                      "prompt": {
                        "type": "string",
                        "example": "Medium shot, the presenter gestures toward the camera, slow push-in",
                        "description": "可选的引导文字，用于描述镜头运动、动作和额外的画面元素。口型和表情仍由音频驱动。"
                      }
                    },
                    "additionalProperties": false,
                    "description": "生成参数。"
                  }
                }
              },
              "examples": {
                "talking_head": {
                  "summary": "用头像生成讲解主持人",
                  "value": {
                    "model": "bytedance/omnihuman-2.0/audio-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/presenter.png"
                      ],
                      "audio_url": "https://example.com/voiceover.mp3"
                    }
                  }
                },
                "singing_prompt": {
                  "summary": "带镜头提示词的演唱角色，带回调",
                  "value": {
                    "model": "bytedance/omnihuman-2.0/audio-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/cartoon-cat.png"
                      ],
                      "audio_url": "https://example.com/song.wav",
                      "prompt": "The cat sways to the beat and raises a paw on the chorus, slow orbit shot, stage lights"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP 状态码。"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "任务 ID，用于[查询任务状态](/zh/api-manual/task-management/status)。"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "任务的初始状态。"
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "任务创建时间（ISO 8601）。"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效、字段不受支持、媒体无法访问或积分不足",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "错误信息。"
                    }
                  }
                }
              }
            }
          },
          "401": {
