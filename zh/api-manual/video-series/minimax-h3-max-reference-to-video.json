{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax H3 Max 参考生视频",
    "description": "根据参考图、参考视频和参考音频生成视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 MiniMax H3 Max 参考生视频任务",
        "operationId": "submitMinimaxH3MaxReferenceToVideoTask",
        "tags": [
          "MiniMax H3 Max Reference to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "imageReferences": {
                  "summary": "参考图",
                  "value": {
                    "model": "minimax/h3-max/reference-to-video",
                    "input": {
                      "prompt": "Image 1 walks through a sunlit street",
                      "reference_image_urls": [
                        "https://example.com/subject.jpg"
                      ]
                    }
                  }
                },
                "mixedReferences": {
                  "summary": "混合参考",
                  "value": {
                    "model": "minimax/h3-max/reference-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Image 1 follows the movement in Video 1 with the atmosphere of Audio 1",
                      "duration": 10,
                      "resolution": "768p",
                      "reference_image_urls": [
                        "https://example.com/subject.jpg"
                      ],
                      "reference_video_urls": [
                        "https://example.com/motion.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://example.com/atmosphere.wav"
                      ],
                      "aspect_ratio": "adaptive",
                      "enable_safety_checker": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1787970600-abcd1234",
                    "status": "not_started",
                    "created_time": "2026-08-29T10:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax/h3-max/reference-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "reference_image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000,
                "description": "描述目标视频的非空提示词。\n\n必须包含至少一个非空白字符。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 15,
                "default": 5,
                "description": "请求的输出时长（秒）。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "768p",
                  "1080p"
                ],
                "default": "768p",
                "description": "输出分辨率。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "设为 false 可关闭安全检查。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16",
                  "adaptive"
                ],
                "default": "adaptive"
              },
              "reference_image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 9,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "公开可访问的 HTTP(S) 下载 URL。"
                },
                "description": "必填的参考图：静态 JPEG/PNG/WebP，每张最大 30 MB。支持的比例：1:1、4:3、3:4、16:9、9:16、5:2、2:5。上传前请先校正方向。"
              },
              "reference_video_urls": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "公开可访问的 HTTP(S) 下载 URL。"
                },
                "description": "MP4/MOV，每个最大 50 MB，每段 2–15 秒，合计最多 15 秒。恒定 24 fps、方形像素、无旋转、16:9 或 9:16。按输出时长截取后，计入的帧数必须为 48、120、240 或 360。"
              },
              "reference_audio_urls": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "公开可访问的 HTTP(S) 下载 URL。"
                },
                "description": "MP3/WAV，每个最大 15 MB，每段 2–15 秒，合计最多 15 秒。单声道/立体声，32 kHz，解码后的采样数必须能被 800 整除。每段不得超过输出时长。"
              }
            },
            "description": "参考素材总数最多 12 个。参考视频和参考音频需要至少一张参考图。"
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
