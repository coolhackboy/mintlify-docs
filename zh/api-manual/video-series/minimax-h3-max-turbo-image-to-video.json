{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax H3 Max Turbo 图生视频",
    "description": "为首帧制作动画，可选尾帧。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 MiniMax H3 Max Turbo 图生视频任务",
        "operationId": "submitMinimaxH3MaxTurboImageToVideoTask",
        "tags": [
          "MiniMax H3 Max Turbo Image to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "firstFrame": {
                  "summary": "单张首帧",
                  "value": {
                    "model": "minimax/h3-max-turbo/image-to-video",
                    "input": {
                      "prompt": "The camera glides forward",
                      "image_urls": [
                        "https://example.com/start.jpg"
                      ]
                    }
                  }
                },
                "firstLastFrames": {
                  "summary": "首帧和尾帧",
                  "value": {
                    "model": "minimax/h3-max-turbo/image-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Daylight turns into sunset",
                      "image_urls": [
                        "https://example.com/start.jpg",
                        "https://example.com/end.jpg"
                      ],
                      "duration": 8,
                      "resolution": "1080P",
                      "enable_safety_checker": false
                    }
                  }
                },
                "base64Frame": {
                  "summary": "Base64 首帧",
                  "value": {
                    "model": "minimax/h3-max-turbo/image-to-video",
                    "input": {
                      "prompt": "Animate the frame",
                      "image_urls": [
                        "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aH1sAAAAASUVORK5CYII="
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1787970600-abcd1234",
                    "status": "not_started",
                    "created_time": "2026-08-29T10:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效"
          },
          "401": {
            "description": "未授权"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "使用 `Authorization: Bearer VIDGO_API_KEY`。"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax/h3-max-turbo/image-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000,
                "description": "描述目标视频的非空提示词。\n\n必须包含至少一个非空白字符。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 15,
                "default": 5,
                "description": "请求的输出时长（秒）。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "768p",
                  "1080p",
                  "480P",
                  "768P",
                  "1080P"
                ],
                "default": "768p",
                "description": "输出分辨率。接受大写 P，并会统一转换为小写。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "设为 false 可关闭安全检查。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "首帧在前，可选尾帧在后。接受 HTTP(S) URL 或 Base64 图像数据。"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
