{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Meshy 6 Text to 3D",
    "description": "Build 3D assets from text with Meshy 6, with mesh topology, material, and texture controls plus optional rigging and animation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Meshy 6 Text to 3D",
        "operationId": "submit_meshy_v6_text_to_3d",
        "description": "Place the parameters listed below inside input. Use publicly accessible HTTP(S) URLs for images and texture references. Set enable_rigging to true when enabling animation. Read files for generated models, preview images, textures, and animation assets; each item provides a file_url and file_type, with file metadata when present.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "meshy/v6/text-to-3d"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 600,
                        "minLength": 1,
                        "description": "Describe the object, shape, and materials in 1–600 characters."
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "preview",
                          "full"
                        ],
                        "default": "full",
                        "description": "Choose preview for geometry or full for the complete generation workflow. Default: full."
                      },
                      "seed": {
                        "type": "integer",
                        "description": "Set an integer seed to repeat a generation configuration."
                      },
                      "topology": {
                        "type": "string",
                        "enum": [
                          "quad",
                          "triangle"
                        ],
                        "default": "triangle",
                        "description": "Choose triangle or quad mesh topology. Default: triangle."
                      },
                      "target_polycount": {
                        "type": "integer",
                        "default": 30000,
                        "description": "Set the target polygon count as an integer. Default: 30000."
                      },
                      "should_remesh": {
                        "type": "boolean",
                        "default": true,
                        "description": "Enable the remeshing stage to apply mesh topology and polygon targets. Default: true."
                      },
                      "symmetry_mode": {
                        "type": "string",
                        "enum": [
                          "off",
                          "auto",
                          "on"
                        ],
                        "default": "auto",
                        "description": "Choose off, auto, or on to control symmetry. Default: auto."
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "description": "Generate metallic, roughness, and normal maps for PBR materials."
                      },
                      "pose_mode": {
                        "type": "string",
                        "enum": [
                          "a-pose",
                          "t-pose",
                          ""
                        ],
                        "default": "",
                        "description": "Choose a-pose, t-pose, or an empty string for the model pose. Default: empty string."
                      },
                      "enable_prompt_expansion": {
                        "type": "boolean",
                        "description": "Expand the text prompt automatically to guide generation."
                      },
                      "texture_prompt": {
                        "type": "string",
                        "description": "Describe colors, surface patterns, and materials to guide texturing."
                      },
                      "texture_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide a publicly accessible HTTP(S) image URL to guide texturing."
                      },
                      "enable_rigging": {
                        "type": "boolean",
                        "description": "Add a skeleton to a humanoid character for posing and animation."
                      },
                      "rigging_height_meters": {
                        "type": "number",
                        "default": 1.7,
                        "description": "Set character height in meters when rigging is enabled. Default: 1.7."
                      },
                      "enable_animation": {
                        "type": "boolean",
                        "description": "Apply an animation preset with enable_rigging set to true."
                      },
                      "animation_action_id": {
                        "type": "integer",
                        "default": 1001,
                        "description": "Set the integer animation preset ID. Default: 1001."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "Enable safety checking for generation inputs. Default: true."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "prompt"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Place model and optional callback_url at the request root, and generation parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "meshy/v6/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "mode": "full",
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "should_remesh": true,
                      "symmetry_mode": "auto",
                      "pose_mode": "",
                      "rigging_height_meters": 1.7,
                      "animation_action_id": 1001,
                      "enable_safety_checker": true
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "meshy/v6/text-to-3d",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "mode": "full",
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "should_remesh": true,
                      "symmetry_mode": "auto",
                      "pose_mode": "",
                      "rigging_height_meters": 1.7,
                      "animation_action_id": 1001,
                      "enable_safety_checker": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Input validation, media access, or account balance error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
