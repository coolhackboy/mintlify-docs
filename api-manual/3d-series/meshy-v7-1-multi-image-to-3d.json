{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Meshy 7.1 Multi-Image to 3D",
    "description": "The Meshy 7.1 Multi-Image to 3D API reconstructs a 3D model from 1–4 views of the same object, with up to 2K geometry, topology control, PBR maps and rigging.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Meshy 7.1 Multi-Image to 3D",
        "operationId": "submit_meshy_v7_1_multi_image_to_3d",
        "description": "Send only the `input` fields listed for this model. Any other field, including `prompt`, `mode`, `seed` or `model_type`, returns 400. `image_urls` takes 1–4 public HTTP(S) URLs or `data:image/...` URIs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `meshy/v7.1/multi-image-to-3d`.",
                    "example": "meshy/v7.1/multi-image-to-3d"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 4,
                        "example": [
                          "https://example.com/chair-front.png",
                          "https://example.com/chair-side.png"
                        ],
                        "description": "1–4 views of the same object (for example front, side, back), as public HTTP(S) URLs or `data:image/...` URIs."
                      },
                      "should_texture": {
                        "type": "boolean",
                        "default": true,
                        "description": "Texture the model. Set `false` for geometry only; then `enable_pbr`, `texture_prompt` and `texture_image_url` are rejected. Texturing adds to the price."
                      },
                      "topology": {
                        "type": "string",
                        "enum": [
                          "triangle",
                          "quad"
                        ],
                        "default": "triangle",
                        "description": "Mesh topology."
                      },
                      "target_polycount": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 300000,
                        "default": 30000,
                        "description": "Target polygon count, `100`–`300000`."
                      },
                      "should_remesh": {
                        "type": "boolean",
                        "default": true,
                        "description": "Remesh the output. Set `false` to keep the raw triangle mesh."
                      },
                      "symmetry_mode": {
                        "type": "string",
                        "enum": [
                          "off",
                          "auto",
                          "on"
                        ],
                        "default": "auto",
                        "description": "Symmetry handling."
                      },
                      "pose_mode": {
                        "type": "string",
                        "enum": [
                          "",
                          "a-pose",
                          "t-pose"
                        ],
                        "default": "",
                        "description": "Character pose. Empty string means no pose constraint; `a-pose` or `t-pose` suit characters you plan to rig."
                      },
                      "geometry_resolution": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "2k"
                        ],
                        "description": "Geometry detail level: `standard` or `2k`. Multi-image does not offer `4k`. It controls mesh detail, not texture size."
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "default": false,
                        "description": "Generate PBR maps (metallic, roughness, normal) in addition to base color. Requires `should_texture: true`."
                      },
                      "enable_rigging": {
                        "type": "boolean",
                        "default": false,
                        "description": "Auto-rig the model as a humanoid character. Adds to the price."
                      },
                      "enable_animation": {
                        "type": "boolean",
                        "default": false,
                        "description": "Apply the animation preset in `animation_action_id`. Requires `enable_rigging: true`. Adds to the price."
                      },
                      "rigging_height_meters": {
                        "type": "number",
                        "default": 1.7,
                        "description": "Character height in meters used for rigging. Must be greater than 0."
                      },
                      "animation_action_id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 696,
                        "default": 92,
                        "description": "Animation preset ID, `0`–`696`."
                      },
                      "texture_prompt": {
                        "type": "string",
                        "maxLength": 600,
                        "description": "Text guidance for the texture, up to 600 characters. Requires `should_texture: true`."
                      },
                      "texture_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Public HTTP(S) URL (or `data:image/...` URI) of an image that guides the texture. Requires `should_texture: true`."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "Run the upstream safety checker."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "three_views": {
                  "summary": "Textured model from three views",
                  "value": {
                    "model": "meshy/v7.1/multi-image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/chair-front.png",
                        "https://example.com/chair-side.png",
                        "https://example.com/chair-back.png"
                      ],
                      "geometry_resolution": "2k",
                      "enable_pbr": true
                    }
                  }
                },
                "geometry_only": {
                  "summary": "Geometry only with callback",
                  "value": {
                    "model": "meshy/v7.1/multi-image-to-3d",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/vase-front.png",
                        "https://example.com/vase-top.png"
                      ],
                      "should_texture": false,
                      "topology": "quad",
                      "target_polycount": 20000
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported field, inaccessible media, or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
