{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Hunyuan 3D v3.1 Pro Image to 3D",
    "description": "Reconstruct 3D objects with Hunyuan 3D v3.1 Pro using a primary image and additional views, with support for PBR materials.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "3D Series"
        ],
        "summary": "Hunyuan 3D v3.1 Pro Image to 3D",
        "operationId": "submit_hunyuan_3d_v3_1_pro_image_to_3d",
        "description": "Generate a 3D asset with the input parameters below. Place model and callback_url at the request root. Read the returned files array for model assets, previews, and companion files.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "hunyuan-3d/v3.1/pro/image-to-3d"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "description": "Optionally describe the desired 3D object using a nonblank string.",
                        "minLength": 1
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "description": "Provide exactly one publicly accessible HTTP(S) image URL."
                      },
                      "generate_type": {
                        "type": "string",
                        "enum": [
                          "Normal",
                          "Geometry"
                        ],
                        "description": "Choose Normal for textured generation or Geometry for a geometry-only white model."
                      },
                      "enable_pbr": {
                        "type": "boolean",
                        "description": "Set true to generate PBR materials in textured mode. Geometry-only generation takes precedence over this setting."
                      },
                      "face_count": {
                        "type": "integer",
                        "minimum": 40000,
                        "maximum": 1500000,
                        "default": 500000,
                        "description": "Set an integer target face count from 40000 to 1500000. Default: 500000."
                      },
                      "back_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the back view as a publicly accessible HTTP(S) image URL."
                      },
                      "left_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the left view as a publicly accessible HTTP(S) image URL."
                      },
                      "right_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the right view as a publicly accessible HTTP(S) image URL."
                      },
                      "top_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the top view as a publicly accessible HTTP(S) image URL."
                      },
                      "bottom_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the bottom view as a publicly accessible HTTP(S) image URL."
                      },
                      "left_front_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the left front view as a publicly accessible HTTP(S) image URL."
                      },
                      "right_front_image_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Provide the right front view as a publicly accessible HTTP(S) image URL."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "image_urls"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Place model and callback_url at the request root and generation parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "hunyuan-3d/v3.1/pro/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "face_count": 500000,
                      "enable_pbr": true,
                      "generate_type": "Normal"
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "hunyuan-3d/v3.1/pro/image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "face_count": 500000,
                      "enable_pbr": true,
                      "generate_type": "Normal"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation or account balance check failed",
