{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - ElevenLabs TTS Turbo v2.5",
    "description": "Create spoken narration with ElevenLabs Turbo v2.5, shaping pacing, vocal style, and voice similarity with optional text alignment.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Audio Series"
        ],
        "summary": "ElevenLabs TTS Turbo v2.5",
        "operationId": "submit_elevenlabs_tts_turbo_v2_5",
        "description": "Place the model parameters inside input. Include 1 to 40,000 Unicode characters of text after trimming leading and trailing whitespace. Read each item in files: generated speech uses file_type=audio. Preserve timestamp files and optional file metadata when present.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "elevenlabs/tts/turbo-v2.5"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "voice": {
                        "type": "string",
                        "default": "Rachel",
                        "description": "Voice name or compatible voice ID. Defaults to Rachel."
                      },
                      "stability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0.5,
                        "description": "Voice stability from 0 to 1. Defaults to 0.5."
                      },
                      "similarity_boost": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0.75,
                        "description": "Voice similarity strength from 0 to 1. Defaults to 0.75."
                      },
                      "style": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "default": 0,
                        "description": "Style exaggeration from 0 to 1. Defaults to 0."
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.7,
                        "maximum": 1.2,
                        "default": 1,
                        "description": "Speech speed from 0.7 to 1.2. Values below 1 slow the delivery; values above 1 speed it up. Defaults to 1."
                      },
                      "timestamps": {
                        "type": "boolean",
                        "default": false,
                        "description": "Request timestamp data alongside the generated audio. Defaults to false."
                      },
                      "previous_text": {
                        "type": "string",
                        "nullable": true,
                        "description": "Text preceding the current segment, used to guide continuity across narration segments."
                      },
                      "next_text": {
                        "type": "string",
                        "nullable": true,
                        "description": "Text following the current segment, used to guide continuity across narration segments."
                      },
                      "language_code": {
                        "type": "string",
                        "nullable": true,
                        "description": "ISO 639-1 language code for the spoken language, such as en, fr, de, ja, vi, hu, or no."
                      },
                      "apply_text_normalization": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "on",
                          "off"
                        ],
                        "default": "auto",
                        "description": "Prepare numbers, dates, and currencies for speech: auto selects normalization automatically, on enables it, and off reads the supplied text directly. Defaults to auto."
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40000,
                        "description": "Text to convert to speech. Include 1 to 40,000 Unicode characters after trimming leading and trailing whitespace."
                      }
                    }
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Place model and optional callback_url at the request root, and the speech parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "One fold at a time",
                  "value": {
                    "model": "elevenlabs/tts/turbo-v2.5",
                    "input": {
                      "similarity_boost": 0.75,
                      "style": 0,
                      "apply_text_normalization": "auto",
                      "text": "Almost there. Fold the top corner down until it meets the center crease. Now press along the edge with your fingertip. That's it. Turn the paper over, and we'll make the next fold together.",
                      "voice": "Rachel",
                      "language_code": "en",
                      "speed": 1.05,
                      "stability": 0.5,
                      "timestamps": false
                    }
                  }
                },
                "turbo-stargazing-zh": {
                  "summary": "Finding north in the night sky",
                  "value": {
                    "model": "elevenlabs/tts/turbo-v2.5",
                    "input": {
                      "similarity_boost": 0.75,
                      "style": 0,
                      "apply_text_normalization": "auto",
                      "text": "今晚，我们先找到北斗七星，再从勺口两颗星的方向寻找北极星。它看起来并不耀眼，却能帮我们辨认北方。在黑暗中安静地等待片刻，你会发现，夜空远比第一眼看到的更丰富。",
                      "voice": "Aria",
                      "language_code": "zh",
                      "speed": 0.95,
                      "stability": 0.6,
                      "timestamps": true
                    }
                  }
                },
                "turbo-memory-es": {
                  "summary": "Two cups of tea",
                  "value": {
                    "model": "elevenlabs/tts/turbo-v2.5",
                    "input": {
                      "similarity_boost": 0.75,
                      "style": 0,
                      "apply_text_normalization": "auto",
                      "text": "Hoy volví a la casa de mi abuela. En la cocina seguía el reloj de siempre, cinco minutos adelantado. Preparé dos tazas de té por costumbre y, al darme cuenta, sonreí. Algunos gestos también guardan recuerdos.",
                      "voice": "Sarah",
                      "language_code": "es",
                      "speed": 0.98,
                      "stability": 0.45,
                      "timestamps": false,
                      "previous_text": "Hacía años que no cruzaba aquella puerta.",
                      "next_text": "Después abrí las ventanas para dejar entrar la luz."
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "elevenlabs/tts/turbo-v2.5",
                    "input": {
                      "similarity_boost": 0.75,
                      "style": 0,
                      "apply_text_normalization": "auto",
                      "text": "Almost there. Fold the top corner down until it meets the center crease. Now press along the edge with your fingertip. That's it. Turn the paper over, and we'll make the next fold together.",
                      "voice": "Rachel",
                      "language_code": "en",
                      "speed": 1.05,
                      "stability": 0.5,
                      "timestamps": false
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "QKTPQMIP4AZY1LGE",
                    "status": "running",
                    "created_time": "2026-09-27T10:51:18"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation error. Check the input parameter types, text length, and numeric ranges.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
