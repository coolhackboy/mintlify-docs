{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax Music 2.6",
    "description": "Create songs from style prompts and lyrics with MiniMax Music 2.6, with support for instrumentals and automatic lyric refinement.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Audio Series"
        ],
        "summary": "MiniMax Music 2.6",
        "operationId": "submit_minimax_music_2_6",
        "description": "Send only the fields shown for this workflow. Parameters from other workflows are rejected before credits are deducted.\n\nWhen supplied, prompt must not be blank.\n\nSupply lyrics unless instrumental mode or automatic lyrics generation is enabled.\n\nRead every item in files. Generated audio uses file_type=audio; timestamp and alignment files may use other. Optional file metadata is retained when available.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "minimax/music-2.6"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 2000,
                        "description": "Prompt."
                      },
                      "lyrics": {
                        "type": "string",
                        "maxLength": 3500,
                        "description": "Lyrics."
                      },
                      "lyrics_optimizer": {
                        "type": "boolean",
                        "default": false,
                        "description": "Lyrics optimizer."
                      },
                      "is_instrumental": {
                        "type": "boolean",
                        "default": false,
                        "description": "Is instrumental."
                      },
                      "audio_setting": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "sample_rate": {
                            "type": "integer",
                            "enum": [
                              16000,
                              24000,
                              32000,
                              44100
                            ],
                            "default": 44100,
                            "description": "Sample rate."
                          },
                          "bitrate": {
                            "type": "integer",
                            "enum": [
                              32000,
                              64000,
                              128000,
                              256000
                            ],
                            "default": 256000,
                            "description": "Bitrate."
                          },
                          "format": {
                            "type": "string",
                            "enum": [
                              "mp3",
                              "wav",
                              "pcm"
                            ],
                            "default": "mp3",
                            "description": "Format."
                          }
                        },
                        "description": "Audio setting."
                      }
                    }
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Keep model and callback_url at the root. Unknown root fields are ignored; unsupported input fields are rejected."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "minimax/music-2.6",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "lyrics_optimizer": false,
                      "is_instrumental": true
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "minimax/music-2.6",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "lyrics_optimizer": false,
                      "is_instrumental": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported tier, inaccessible media, or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
