{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax Music 2.6",
    "description": "Generate songs and instrumental music from style prompts and lyrics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Audio Series"
        ],
        "summary": "MiniMax Music 2.6",
        "operationId": "submit_minimax_music_2_6",
        "description": "Generate songs with custom or automatic lyrics, or create instrumental music. Retrieve the completed audio through Query Task Status or a callback_url notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "minimax/music-2.6",
                    "enum": [
                      "minimax/music-2.6"
                    ],
                    "description": "Model identifier for MiniMax Music 2.6."
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 2000,
                        "description": "10–2000 characters describing genre, mood, instrumentation, tempo or vocal direction."
                      },
                      "lyrics": {
                        "type": "string",
                        "maxLength": 3500,
                        "description": "Up to 3500 characters. Supply lyrics when both is_instrumental and lyrics_optimizer are false. For instrumental music, leave lyrics empty."
                      },
                      "lyrics_optimizer": {
                        "type": "boolean",
                        "default": false,
                        "description": "When true and lyrics is empty, generates lyrics from prompt. Set false for instrumental music."
                      },
                      "is_instrumental": {
                        "type": "boolean",
                        "default": false,
                        "description": "Set true for instrumental music, with empty lyrics and lyrics_optimizer set to false."
                      },
                      "audio_setting": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "sample_rate": {
                            "type": "integer",
                            "enum": [
                              16000,
                              24000,
                              32000,
                              44100
                            ],
                            "default": 44100,
                            "description": "Sample rate in Hz."
                          },
                          "bitrate": {
                            "type": "integer",
                            "enum": [
                              32000,
                              64000,
                              128000,
                              256000
                            ],
                            "default": 256000,
                            "description": "Bitrate in bits per second."
                          },
                          "format": {
                            "type": "string",
                            "enum": [
                              "mp3",
                              "wav",
                              "pcm"
                            ],
                            "default": "mp3",
                            "description": "Audio file format."
                          }
                        },
                        "description": "Audio output settings containing sample_rate, bitrate and format."
                      }
                    },
                    "description": "Supply lyrics for vocal music, enable lyrics_optimizer with empty lyrics for automatic writing, or set is_instrumental to true with empty lyrics and lyrics_optimizer false."
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional HTTP(S) callback URL for task completion or failure notifications."
                  }
                },
                "description": "Set model and optional callback_url at the request root. Place music parameters inside input."
              },
              "examples": {
                "custom-lyrics": {
                  "summary": "Create a song with custom lyrics",
                  "value": {
                    "model": "minimax/music-2.6",
                    "input": {
                      "prompt": "City pop, 100 BPM, warm female vocals, electric piano, rounded synth bass and a nostalgic evening mood",
                      "lyrics": "[Verse]\nThe evening lights begin to glow\nWe follow streets we used to know\n[Chorus]\nCarry the melody into the night\nFollow the rhythm until morning light",
                      "lyrics_optimizer": false,
                      "is_instrumental": false,
                      "audio_setting": {
                        "sample_rate": 44100,
                        "bitrate": 256000,
                        "format": "mp3"
                      }
                    }
                  }
                },
                "automatic-lyrics": {
                  "summary": "Generate lyrics from the music prompt",
                  "value": {
                    "model": "minimax/music-2.6",
                    "input": {
                      "prompt": "Uplifting indie folk song about a rooftop garden, acoustic guitar, gentle drums and warm English vocals",
                      "lyrics_optimizer": true,
                      "is_instrumental": false
                    }
                  }
                },
                "instrumental": {
                  "summary": "Create an instrumental track",
                  "value": {
                    "model": "minimax/music-2.6",
                    "input": {
                      "prompt": "Instrumental ambient piano, soft strings, slow flowing rhythm and a peaceful morning atmosphere",
                      "is_instrumental": true,
                      "lyrics_optimizer": false,
                      "audio_setting": {
                        "sample_rate": 44100,
                        "bitrate": 256000,
                        "format": "wav"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed or account credits are insufficient. Review the response detail and correct the request or account balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
