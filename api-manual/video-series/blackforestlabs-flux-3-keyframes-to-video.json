{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 Keyframes to Video",
    "description": "Build video sequences around chosen image keyframes with FLUX 3, controlling where visual references appear along the timeline.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "FLUX 3 Keyframes to Video",
        "operationId": "submit_blackforestlabs_flux_3_keyframes_to_video",
        "description": "Send only the fields shown for this workflow. Parameters from other workflows are rejected before credits are deducted.\n\nWhen supplied, prompt must not be blank. Input URL fields require HTTP(S) URLs with a hostname and no embedded credentials.\n\nKeyframe positions must be unique and between zero and duration multiplied by 24.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "blackforestlabs/flux-3/keyframes-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "keyframes",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Prompt."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20,
                        "default": 5,
                        "description": "Duration."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "Resolution."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "2:1",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "9:16"
                        ],
                        "default": "auto",
                        "description": "Aspect ratio."
                      },
                      "sound": {
                        "type": "boolean",
                        "default": true,
                        "description": "Sound."
                      },
                      "keyframes": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 10,
                        "items": {
                          "type": "object",
                          "required": [
                            "image_url",
                            "frame_index"
                          ],
                          "properties": {
                            "image_url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Image url."
                            },
                            "frame_index": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "Frame index."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Keyframes."
                        },
                        "description": "Keyframes."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Keep model and callback_url at the root. Unknown root fields are ignored; unsupported input fields are rejected."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "blackforestlabs/flux-3/keyframes-to-video",
                    "input": {
                      "keyframes": [
                        {
                          "image_url": "https://example.com/image.png",
                          "frame_index": 0
                        }
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "auto",
                      "sound": true
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "blackforestlabs/flux-3/keyframes-to-video",
                    "input": {
                      "keyframes": [
                        {
                          "image_url": "https://example.com/image.png",
                          "frame_index": 0
                        }
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "auto",
                      "sound": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
