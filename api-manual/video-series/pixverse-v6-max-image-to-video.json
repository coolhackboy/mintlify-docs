{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - PixVerse V6 Max Image to Video",
    "description": "The PixVerse V6 Max Image to Video API animates one JPEG, PNG or WebP image into a 1–15 second video at 360p to 1080p, keeping the image's framing.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "PixVerse V6 Max Image to Video",
        "operationId": "submit_pixverse_v6_max_image_to_video",
        "description": "Send only the `input` fields listed for this model. Any other field, including `aspect_ratio`, returns 400. The image URL must be a public HTTP(S) URL without embedded credentials; if it has a file extension, it must be .jpg, .jpeg, .png or .webp.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `pixverse/v6-max/image-to-video`.",
                    "example": "pixverse/v6-max/image-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/packshot.png"
                        ],
                        "description": "Exactly one public HTTP(S) image URL (JPEG, PNG or WebP). It is the start frame and sets the aspect ratio."
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "example": "The perfume bottle rotates slowly as petals fall around it, soft studio light",
                        "description": "Optional motion description: what moves, how the camera moves and, with `audio` on, the sound. Must not be blank if sent; up to 2,048 characters."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "default": 5,
                        "description": "Output length in whole seconds. `null` counts as the default."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "360p",
                          "540p",
                          "720p",
                          "1080p"
                        ],
                        "default": "540p",
                        "description": "Output resolution. It sets the billing rate. `null` counts as the default."
                      },
                      "audio": {
                        "type": "boolean",
                        "default": false,
                        "description": "Add a native audio track (dialogue, effects, music). It changes the billing rate. `null` counts as the default."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "product": {
                  "summary": "5-second 720p product animation",
                  "value": {
                    "model": "pixverse/v6-max/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/packshot.png"
                      ],
                      "prompt": "The perfume bottle rotates slowly as petals fall around it, soft studio light",
                      "duration": 5,
                      "resolution": "720p",
                      "audio": false
                    }
                  }
                },
                "with_audio": {
                  "summary": "8-second 1080p clip with audio and callback",
                  "value": {
                    "model": "pixverse/v6-max/image-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/guitarist.jpg"
                      ],
                      "prompt": "The guitarist strums the final chord and the crowd cheers, camera pulls back",
                      "duration": 8,
                      "resolution": "1080p",
                      "audio": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
