{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Vidu Q4 Reference to Video",
    "description": "The Vidu Q4 Reference to Video API builds a 3–16 second video from 1–12 reference images and up to 3 voice clips, with optional audio and up to 4K.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Vidu Q4 Reference to Video",
        "operationId": "submit_vidu_q4_reference_to_video",
        "description": "Send only the `input` fields listed for this model. Any other field, including `image_urls`, returns 400. Reference URLs must be public HTTP(S) URLs without embedded credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `vidu/q4/reference-to-video`.",
                    "example": "vidu/q4/reference-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "reference_image_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000,
                        "example": "[@reference_image_1] walks into the cafe from [@reference_image_2] and greets the barista, speaking in the voice of [@reference_audio_1]",
                        "description": "Describe the scene and how the references are used. Refer to them by array order as `[@reference_image_1]`, `[@reference_audio_1]` and so on. Must not be blank; up to 5,000 characters."
                      },
                      "reference_image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 12,
                        "example": [
                          "https://example.com/character.png",
                          "https://example.com/cafe.png"
                        ],
                        "description": "1–12 public HTTP(S) reference image URLs: characters, products, outfits or locations."
                      },
                      "reference_audio_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "maxItems": 3,
                        "example": [
                          "https://example.com/voice.mp3"
                        ],
                        "description": "Up to 3 public HTTP(S) audio URLs used as voice references. Short, clean MP3 voice clips work best."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 16,
                        "default": 5,
                        "description": "Output length in seconds (integer, an integer string such as `\"5\"` is also accepted)."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "540p",
                          "720p",
                          "1080p",
                          "2k",
                          "4k"
                        ],
                        "default": "720p",
                        "description": "Output resolution (case-insensitive). It sets the billing rate."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "16:9",
                          "9:16",
                          "4:3",
                          "3:4",
                          "1:1"
                        ],
                        "description": "Output aspect ratio. When omitted, the upstream default (16:9) applies."
                      },
                      "generate_audio": {
                        "type": "boolean",
                        "description": "Generate native audio with the video. When omitted, the upstream default (no audio) applies. Does not change the price."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "description": "Turn the upstream safety checker on or off. When omitted, the upstream default applies."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "images_only": {
                  "summary": "Two reference images, 720p",
                  "value": {
                    "model": "vidu/q4/reference-to-video",
                    "input": {
                      "prompt": "[@reference_image_1] holds up the sneaker from [@reference_image_2] and spins it slowly under studio light",
                      "reference_image_urls": [
                        "https://example.com/model.png",
                        "https://example.com/sneaker.png"
                      ],
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "9:16"
                    }
                  }
                },
                "voice_reference": {
                  "summary": "Character with voice reference and audio, 1080p",
                  "value": {
                    "model": "vidu/q4/reference-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "[@reference_image_1] walks into the cafe from [@reference_image_2] and greets the barista, speaking in the voice of [@reference_audio_1]: \"Morning! The usual, please.\"",
                      "reference_image_urls": [
                        "https://example.com/character.png",
                        "https://example.com/cafe.png"
                      ],
                      "reference_audio_urls": [
                        "https://example.com/voice.mp3"
                      ],
                      "duration": 8,
                      "resolution": "1080p",
                      "aspect_ratio": "16:9",
                      "generate_audio": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported field, inaccessible media, or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "Error message."
                    }
                  }
                }
              }
            }
          },
          "401": {
