{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Omni Flash Video Edit",
    "description": "Rework existing video with Gemini Omni Flash, using written instructions to guide changes to the scene with output up to 4K.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Omni Flash Video Edit",
        "operationId": "submit_google_gemini_omni_flash_video_edit",
        "description": "Send only the fields shown for this workflow. Parameters from other workflows are rejected before credits are deducted.\n\nWhen supplied, prompt and text must not be blank. Input URL fields require HTTP(S) URLs with a hostname and no embedded credentials.\n\nVideo editing requires exactly one video URL in video_urls; missing or empty arrays are rejected. Omit duration. No source-video duration limit is imposed by this workflow.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "google/gemini-omni-flash/video-edit"
                    ],
                    "example": "google/gemini-omni-flash/video-edit",
                    "description": "Vidgo public model ID. Must be `google/gemini-omni-flash/video-edit`."
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "video_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 20000,
                        "minLength": 1,
                        "description": "Prompt."
                      },
                      "video_urls": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "Video urls."
                        },
                        "description": "Required: exactly one publicly accessible HTTP(S) source video URL. Missing or empty arrays are rejected. Omit duration; no source-video duration limit is imposed by this workflow."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p",
                          "4k"
                        ],
                        "default": "720p",
                        "description": "Resolution."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "16:9",
                          "9:16"
                        ],
                        "default": "16:9",
                        "description": "Aspect ratio."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Keep model and callback_url at the root. Unknown root fields are ignored; unsupported input fields are rejected."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "google/gemini-omni-flash/video-edit",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "video_urls": [
                        "https://example.com/video.mp4"
                      ],
                      "resolution": "720p",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "google/gemini-omni-flash/video-edit",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "video_urls": [
                        "https://example.com/video.mp4"
                      ],
                      "resolution": "720p",
                      "aspect_ratio": "16:9"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported tier, inaccessible media, or insufficient credits",
