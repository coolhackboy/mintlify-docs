{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - OmniHuman 2.0 Audio to Video",
    "description": "The OmniHuman 2.0 Audio to Video API animates one character image with a 4–300 second WAV or MP3 file into a 720p lip-synced video, with optional prompts.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "OmniHuman 2.0 Audio to Video",
        "operationId": "submit_bytedance_omnihuman_2_0_audio_to_video",
        "description": "Send only `image_urls`, `audio_url` and an optional `prompt` inside `input`. Any other field, including `duration`, `resolution` or `aspect_ratio`, returns 400. The audio is downloaded and probed at submission: it must be WAV or MP3, at most 15 MB and 4–300 seconds long.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `bytedance/omnihuman-2.0/audio-to-video`.",
                    "example": "bytedance/omnihuman-2.0/audio-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "audio_url"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/presenter.png"
                        ],
                        "description": "Exactly one public HTTP(S) image URL of the character: a person, an animal, or a cartoon, 3D or stylized character. Multi-person images work too. The framing follows this image."
                      },
                      "audio_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/voiceover.mp3",
                        "description": "Public HTTP(S) URL of the driving audio: a WAV or MP3 file, at most 15 MB and 4–300 seconds long. The video length follows the audio."
                      },
                      "prompt": {
                        "type": "string",
                        "example": "Medium shot, the presenter gestures toward the camera, slow push-in",
                        "description": "Optional guidance for camera movement, actions and extra scene elements. Lip movement and expression still follow the audio."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "talking_head": {
                  "summary": "Talking presenter from a headshot",
                  "value": {
                    "model": "bytedance/omnihuman-2.0/audio-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/presenter.png"
                      ],
                      "audio_url": "https://example.com/voiceover.mp3"
                    }
                  }
                },
                "singing_prompt": {
                  "summary": "Singing character with a camera prompt and callback",
                  "value": {
                    "model": "bytedance/omnihuman-2.0/audio-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/cartoon-cat.png"
                      ],
                      "audio_url": "https://example.com/song.wav",
                      "prompt": "The cat sways to the beat and raises a paw on the chorus, slow orbit shot, stage lights"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
