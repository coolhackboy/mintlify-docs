{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - PixVerse V6 Max Text to Video",
    "description": "The PixVerse V6 Max Text to Video API generates 1–15 second videos from a prompt at 360p to 1080p, with eight aspect ratios and an optional native audio track.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "PixVerse V6 Max Text to Video",
        "operationId": "submit_pixverse_v6_max_text_to_video",
        "description": "Send only the `input` fields listed for this model. Any other field, including `image_urls`, returns 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `pixverse/v6-max/text-to-video`.",
                    "example": "pixverse/v6-max/text-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000,
                        "example": "A street dancer spins under a flickering neon sign in the rain, low-angle tracking shot",
                        "description": "Describe the scene, the action and the camera. With `audio` on, put dialogue in quotes and name the speaker, and describe ambience or music. Must not be blank; up to 5,000 characters."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "default": 5,
                        "description": "Output length in whole seconds. `null` counts as the default."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "360p",
                          "540p",
                          "720p",
                          "1080p"
                        ],
                        "default": "540p",
                        "description": "Output resolution. It sets the billing rate. `null` counts as the default."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "16:9",
                          "9:16",
                          "4:3",
                          "3:4",
                          "1:1",
                          "2:3",
                          "3:2",
                          "21:9"
                        ],
                        "description": "Output aspect ratio. When omitted, the upstream default (16:9) applies."
                      },
                      "audio": {
                        "type": "boolean",
                        "default": false,
                        "description": "Add a native audio track (dialogue, effects, music). It changes the billing rate. `null` counts as the default."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "draft": {
                  "summary": "5-second 540p silent draft",
                  "value": {
                    "model": "pixverse/v6-max/text-to-video",
                    "input": {
                      "prompt": "A street dancer spins under a flickering neon sign in the rain, low-angle tracking shot",
                      "duration": 5,
                      "resolution": "540p",
                      "aspect_ratio": "16:9",
                      "audio": false
                    }
                  }
                },
                "dialogue": {
                  "summary": "10-second vertical 1080p clip with dialogue",
                  "value": {
                    "model": "pixverse/v6-max/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Two friends share an umbrella at a bus stop at night. The woman laughs and says: \"You forgot yours again?\" Rain patters on the umbrella, distant traffic.",
                      "duration": 10,
                      "resolution": "1080p",
                      "aspect_ratio": "9:16",
                      "audio": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported field, inaccessible media, or insufficient credits",
