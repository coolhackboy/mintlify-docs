{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Vidu Q4 Image to Video",
    "description": "The Vidu Q4 Image to Video API animates one start image into a 3–16 second video at 540p, 720p, 1080p, 2K or 4K, keeping the image's aspect ratio.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Vidu Q4 Image to Video",
        "operationId": "submit_vidu_q4_image_to_video",
        "description": "Send only the `input` fields listed for this model. Any other field, including `aspect_ratio`, `generate_audio` or the reference fields, returns 400. The image URL must be a public HTTP(S) URL without embedded credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `vidu/q4/image-to-video`.",
                    "example": "vidu/q4/image-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls"
                    ],
                    "properties": {
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/still.png"
                        ],
                        "description": "Exactly one public HTTP(S) image URL. It becomes the first frame, and the video keeps its aspect ratio."
                      },
                      "prompt": {
                        "type": "string",
                        "maxLength": 5000,
                        "default": "",
                        "example": "The lantern flickers as the girl looks up and snow starts to fall, slow push-in",
                        "description": "Optional motion description: what moves, how the camera moves and the mood. Up to 5,000 characters."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 16,
                        "default": 5,
                        "description": "Output length in seconds (integer, an integer string such as `\"5\"` is also accepted)."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "540p",
                          "720p",
                          "1080p",
                          "2k",
                          "4k"
                        ],
                        "default": "720p",
                        "description": "Output resolution (case-insensitive). It sets the billing rate."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "description": "Turn the upstream safety checker on or off. When omitted, the upstream default applies."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "5-second 720p animation",
                  "value": {
                    "model": "vidu/q4/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/still.png"
                      ],
                      "prompt": "The lantern flickers as the girl looks up and snow starts to fall, slow push-in",
                      "duration": 5,
                      "resolution": "720p"
                    }
                  }
                },
                "uhd": {
                  "summary": "10-second 4K hero shot with callback",
                  "value": {
                    "model": "vidu/q4/image-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://example.com/key-visual.png"
                      ],
                      "prompt": "Slow aerial orbit around the lighthouse as waves crash below, golden hour",
                      "duration": 10,
                      "resolution": "4k"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
