{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Wan 2.7 Video Text to Video",
    "description": "Wan 2.7 Video Text to Video through the Vidgo unified submit API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
