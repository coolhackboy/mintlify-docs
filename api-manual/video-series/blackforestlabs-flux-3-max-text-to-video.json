{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 Max Text to Video",
    "description": "The FLUX 3 Max Text to Video API generates 5–20 second videos from a text prompt at 720p or 1080p, with eight aspect ratios and optional native audio.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "FLUX 3 Max Text to Video",
        "operationId": "submit_blackforestlabs_flux_3_max_text_to_video",
        "description": "Send only the `input` fields listed for this model. Any other field, including `image_urls` or `keyframes`, returns 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `blackforestlabs/flux-3-max/text-to-video`.",
                    "example": "blackforestlabs/flux-3-max/text-to-video"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "example": "A paper boat drifts down a rain-soaked city gutter at dusk, neon reflections rippling, slow tracking shot",
                        "description": "Describe the scene, the subject's motion, camera movement and, if `sound` is on, the sounds or dialogue you want. Must not be blank."
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 5,
                        "maximum": 20,
                        "default": 5,
                        "description": "Output length in seconds (integer)."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p",
                        "description": "Output resolution. It sets the billing rate."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "2:1",
                          "16:9",
                          "4:3",
                          "1:1",
                          "3:4",
                          "9:16"
                        ],
                        "default": "auto",
                        "description": "Output aspect ratio. `auto` lets the model choose: 16:9 for text-only prompts, the shape of the first image when images are supplied."
                      },
                      "sound": {
                        "type": "boolean",
                        "default": true,
                        "description": "Generate native audio in the same pass. Set `false` for a silent video. Does not change the price."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "5-second 720p clip with audio",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/text-to-video",
                    "input": {
                      "prompt": "A paper boat drifts down a rain-soaked city gutter at dusk, neon reflections rippling, slow tracking shot, soft rain and distant traffic",
                      "duration": 5,
                      "resolution": "720p",
                      "aspect_ratio": "16:9",
                      "sound": true
                    }
                  }
                },
                "vertical_silent": {
                  "summary": "15-second vertical 1080p clip, silent",
                  "value": {
                    "model": "blackforestlabs/flux-3-max/text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A barista pours latte art in slow motion, overhead close-up, warm cafe light",
                      "duration": 15,
                      "resolution": "1080p",
                      "aspect_ratio": "9:16",
                      "sound": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
