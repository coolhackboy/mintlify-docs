  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Happy Horse 1.1 Image to Video",
        "operationId": "submit_alibaba_happyhorse_1_1_image_to_video",
        "description": "Send only the fields shown for this workflow. Parameters from other workflows are rejected before credits are deducted.\n\nPrompts are trimmed and limited to 2,500 Unicode characters. An omitted, null, empty, or whitespace-only prompt is accepted. Image arrays accept public HTTP(S) URLs, image Data URIs, or raw Base64; conversion completes before credits are deducted.\n\nChoose an integer duration from three to fifteen seconds (default five) and 720p or 1080p resolution (default 1080p). Usage equals requested output seconds multiplied by the selected resolution rate. See [Pricing](https://vidgo.ai/apis/api-pricing) for current rates.\n\nProvide exactly one image in image_urls.\n\n`duration` and `seed` also accept integer strings such as `\"5\"`; decimal numbers such as `5.0` and decimal strings such as `\"5.0\"` are rejected. Null or empty values use the default duration or omit the seed. Supported boolean fields also accept `0`/`1` and case-insensitive strings `true`/`false`, `1`/`0`, `yes`/`no`, `y`/`n`, and `on`/`off`; null omits the field. Surrounding whitespace is trimmed, and resolution values are case-insensitive.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "description": "Keep model and callback_url at the root. Unknown root fields are ignored; unsupported input fields are rejected.",
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "alibaba/happyhorse-1.1/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 2500,
                        "minLength": 0,
                        "nullable": true,
                        "description": "Trim surrounding whitespace. Maximum 2,500 Unicode characters. Required for text-to-video and reference-to-video; optional for image-to-video."
                      },
                      "image_urls": {
                        "type": "array",
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Image urls."
                        },
                        "minItems": 1,
                        "description": "Exactly one first-frame image. Accepts public HTTP(S) URLs, image Data URIs, or raw Base64."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "1080p",
                        "description": "Output resolution"
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 15,
                        "default": 5,
                        "description": "Output duration in seconds. Credits are calculated by duration and selected resolution."
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647,
                        "description": "Optional random seed for reproducible generation"
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "description": "Enable content moderation for input and output"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "image_urls"
                    ]
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "alibaba/happyhorse-1.1/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "resolution": "1080p",
                      "duration": 5
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "alibaba/happyhorse-1.1/image-to-video",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "resolution": "1080p",
                      "duration": 5
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
