{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - MiniMax H3 Max Image to Video",
    "description": "Animate a starting frame with an optional ending frame.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit MiniMax H3 Max Image to Video Task",
        "operationId": "submitMinimaxH3MaxImageToVideoTask",
        "tags": [
          "MiniMax H3 Max Image to Video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "firstFrame": {
                  "summary": "Single starting frame",
                  "value": {
                    "model": "minimax/h3-max/image-to-video",
                    "input": {
                      "prompt": "The camera glides forward",
                      "image_urls": [
                        "https://example.com/start.jpg"
                      ]
                    }
                  }
                },
                "firstLastFrames": {
                  "summary": "Starting and ending frames",
                  "value": {
                    "model": "minimax/h3-max/image-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Daylight turns into sunset",
                      "image_urls": [
                        "https://example.com/start.jpg",
                        "https://example.com/end.jpg"
                      ],
                      "duration": 8,
                      "resolution": "1080p",
                      "enable_safety_checker": false
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1787970600-abcd1234",
                    "status": "not_started",
                    "created_time": "2026-08-29T10:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Use `Authorization: Bearer VIDGO_API_KEY`."
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "example": "minimax/h3-max/image-to-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook callback URL."
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000,
                "pattern": "\\S",
                "description": "Non-empty prompt describing the target video."
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 15,
                "default": 5,
                "description": "Requested output duration in seconds."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "768p",
                  "1080p"
                ],
                "default": "768p",
                "description": "Output resolution."
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Set false to disable the safety checker."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "description": "Publicly accessible HTTP(S) download URL."
                },
                "description": "Starting frame followed by an optional ending frame. Public HTTP(S) URLs only."
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
