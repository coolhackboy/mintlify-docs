{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedance 1.5 Pro Image to Video",
    "description": "Animate reference images with Seedance 1.5 Pro, with optional generated audio and fixed-camera control at up to 1080p.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Video Series"
        ],
        "summary": "Seedance 1.5 Pro Image to Video",
        "operationId": "submit_bytedance_seedance_v1_5_pro_image_to_video",
        "description": "Submit a Seedance 1.5 Pro image-to-video task. Set model and optional callback_url at the request root and generation parameters inside input.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "bytedance/seedance-v1.5-pro/image-to-video"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "aspect_ratio",
                      "duration",
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2500,
                        "description": "Describe the scene, subject actions, camera movement and sound. Supply 3–2,500 Unicode characters after trimming surrounding whitespace."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public HTTP(S) URL of a JPEG, PNG or WebP image."
                        },
                        "maxItems": 2,
                        "minItems": 1,
                        "description": "Supply 1–2 publicly accessible HTTP(S) image URLs in order: first frame, then optional last frame. Use JPEG, PNG or WebP images, up to 10 MB each."
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "21:9",
                          "4:3",
                          "3:4",
                          "16:9",
                          "9:16"
                        ],
                        "description": "Output frame aspect ratio: 1:1, 21:9, 4:3, 3:4, 16:9 or 9:16."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "480p",
                          "720p",
                          "1080p"
                        ],
                        "description": "Output resolution: 480p, 720p or 1080p. Vidgo defaults to 720p when omitted.",
                        "default": "720p"
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          4,
                          8,
                          12
                        ],
                        "description": "Video duration in seconds. Supply the integer 4, 8 or 12."
                      },
                      "fixed_lens": {
                        "type": "boolean",
                        "description": "Set true to keep the camera fixed, or false to allow camera movement."
                      },
                      "generate_audio": {
                        "type": "boolean",
                        "description": "Set true to generate synchronized audio, or false to generate a silent video. Vidgo defaults to true when omitted.",
                        "default": true
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) URL for task completion notifications. Use HTTPS to receive finished or failed task results."
                  }
                },
                "description": "Set model and optional callback_url at the request root. Place generation parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "bytedance/seedance-v1.5-pro/image-to-video",
                    "input": {
                      "aspect_ratio": "1:1",
                      "duration": 4,
                      "generate_audio": false,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "480p"
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "bytedance/seedance-v1.5-pro/image-to-video",
                    "input": {
                      "aspect_ratio": "1:1",
                      "duration": 4,
                      "generate_audio": false,
                      "image_urls": [
                        "https://example.com/image.png"
                      ],
                      "prompt": "A quiet forest under soft morning light, with natural detail.",
                      "resolution": "480p"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
