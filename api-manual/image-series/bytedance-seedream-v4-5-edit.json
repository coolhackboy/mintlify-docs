{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedream 4.5 Edit",
    "description": "Edit images with Seedream 4.5 using a text prompt and 1-10 reference images, generating 1-15 edited images per request.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Seedream 4.5 Edit",
        "operationId": "submit_bytedance_seedream_v4_5_edit",
        "description": "Submit an asynchronous image editing task. Provide a prompt containing 1–3,000 characters. Custom size width and height are positive integers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "bytedance/seedream/v4.5/edit",
                    "enum": [
                      "bytedance/seedream/v4.5/edit"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 3000,
                        "minLength": 1,
                        "description": "Describe the requested changes using 1–3,000 characters, including at least one non-whitespace character."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public HTTP(S) URL of a JPEG or PNG image."
                        },
                        "minItems": 1,
                        "maxItems": 10,
                        "description": "1–10 ordered HTTP(S) reference image URLs. Formats: JPEG, PNG."
                      },
                      "size": {
                        "oneOf": [
                          {
                            "type": "string",
                            "enum": [
                              "2K",
                              "4K",
                              "1:1",
                              "4:3",
                              "3:4",
                              "16:9",
                              "9:16",
                              "3:2",
                              "2:3",
                              "21:9"
                            ],
                            "description": "Resolution or aspect-ratio preset."
                          },
                          {
                            "type": "string",
                            "pattern": "^\\s*\\d+\\s*[xX]\\s*\\d+\\s*$",
                            "description": "Custom dimensions, for example 1920x4096. Width and height are positive integers."
                          },
                          {
                            "type": "object",
                            "required": [
                              "width",
                              "height"
                            ],
                            "properties": {
                              "width": {
                                "type": "integer",
                                "description": "Output width in pixels; a positive integer.",
                                "minimum": 1
                              },
                              "height": {
                                "type": "integer",
                                "description": "Output height in pixels; a positive integer.",
                                "minimum": 1
                              }
                            },
                            "additionalProperties": false,
                            "description": "Custom dimensions as an object with positive integer width and height."
                          }
                        ],
                        "default": "1:1",
                        "description": "Output size: 2K, 4K, a ratio preset, a WIDTHxHEIGHT string, or an object with positive integer width and height. Default: 1:1."
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "default": 1,
                        "description": "Number of images to generate, from 1 to 15. Default: 1."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "Set true to enable safety checking or false to disable it. Default: true."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) URL for task completion notifications."
                  }
                },
                "description": "Set model and optional callback_url at the request root. Place generation parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "Verified default: Launching the Toy Boat",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural photograph. Use the boy from image 1 with the same face, curly dark hair, freckles, red hooded raincoat with wooden toggles, navy trousers and yellow rubber boots. Use the exact toy sailboat from image 2: teal wooden hull with a white stripe, cream canvas sail with the stitched patch and dark blue painted star, red string at the bow. Place them on the misty loch shoreline from image 3. The boy crouches on the flat rocks at the water's edge, seen in three-quarter side view, gently setting the sailboat onto the calm water with both hands while holding the red string; small ripples spread around the hull. Keep the pebbles, rust bracken hills and misty pines of the location. Soft overcast morning light, consistent scale and shadows, realistic reflections in the water, a quiet tender moment, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-03.png"
                      ],
                      "size": "3:2",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "verified-2": {
                  "summary": "Verified example: Recarved Canyon Trail Sign",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Edit only the carved text on the two wooden arrow boards. Change the upper board text to exactly \"HIDDEN SPRING 2 MI\" and the lower board text to exactly \"RANGER CABIN 5 MI\". Keep the same arrow directions, the same deeply carved cream-painted capital letters, the same font style, letter depth, wood grain, weathering and perspective of each board. Keep everything else unchanged: the post, sagebrush, boulders, red canyon cliffs, sky, lighting and shadows. No other text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/02/input-01.png"
                      ],
                      "size": "4:3",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "verified-3": {
                  "summary": "Verified example: Crayon Picnic Diorama",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Turn this child's crayon drawing into a photograph of a handcrafted miniature diorama built on a tabletop, keeping the exact same composition and layout. The big tree with the round green crown and the wooden treehouse with its rope ladder stays on the left; the family of four sits on the red and white checkered picnic blanket on the right with the basket and watermelon slice; the spotty black-and-white dog runs in the same place; the yellow sun sits in the top right corner with the blue clouds on a painted backdrop; green grass and two red flowers along the bottom. Make everything tangible: sculpted clay figures with simple friendly faces, a real twig tree trunk with felt leaves, a tiny balsa-wood treehouse, fabric blanket, flocked grass. Macro photography with shallow depth of field, soft warm window light, tilt-shift miniature feeling, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/03/input-01.png"
                      ],
                      "size": "4:3",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural photograph. Use the boy from image 1 with the same face, curly dark hair, freckles, red hooded raincoat with wooden toggles, navy trousers and yellow rubber boots. Use the exact toy sailboat from image 2: teal wooden hull with a white stripe, cream canvas sail with the stitched patch and dark blue painted star, red string at the bow. Place them on the misty loch shoreline from image 3. The boy crouches on the flat rocks at the water's edge, seen in three-quarter side view, gently setting the sailboat onto the calm water with both hands while holding the red string; small ripples spread around the hull. Keep the pebbles, rust bracken hills and misty pines of the location. Soft overcast morning light, consistent scale and shadows, realistic reflections in the water, a quiet tender moment, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-03.png"
                      ],
                      "size": "3:2",
                      "n": 1,
                      "enable_safety_checker": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "custom-string": {
                  "summary": "Custom size string",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural photograph. Use the boy from image 1 with the same face, curly dark hair, freckles, red hooded raincoat with wooden toggles, navy trousers and yellow rubber boots. Use the exact toy sailboat from image 2: teal wooden hull with a white stripe, cream canvas sail with the stitched patch and dark blue painted star, red string at the bow. Place them on the misty loch shoreline from image 3. The boy crouches on the flat rocks at the water's edge, seen in three-quarter side view, gently setting the sailboat onto the calm water with both hands while holding the red string; small ripples spread around the hull. Keep the pebbles, rust bracken hills and misty pines of the location. Soft overcast morning light, consistent scale and shadows, realistic reflections in the water, a quiet tender moment, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-03.png"
                      ],
                      "size": "1920x4096",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "custom-object": {
                  "summary": "Custom size object",
                  "value": {
                    "model": "bytedance/seedream/v4.5/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural photograph. Use the boy from image 1 with the same face, curly dark hair, freckles, red hooded raincoat with wooden toggles, navy trousers and yellow rubber boots. Use the exact toy sailboat from image 2: teal wooden hull with a white stripe, cream canvas sail with the stitched patch and dark blue painted star, red string at the bow. Place them on the misty loch shoreline from image 3. The boy crouches on the flat rocks at the water's edge, seen in three-quarter side view, gently setting the sailboat onto the calm water with both hands while holding the red string; small ripples spread around the hull. Keep the pebbles, rust bracken hills and misty pines of the location. Soft overcast morning light, consistent scale and shadows, realistic reflections in the water, a quiet tender moment, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v4.5/edit/v1/01/input-03.png"
                      ],
                      "size": {
                        "width": 2304,
                        "height": 3072
                      },
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "GAPP1TYEWHR5CQVS",
                    "status": "running",
                    "created_time": "2026-09-25T16:16:53"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation or account balance error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
