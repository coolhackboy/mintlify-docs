{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Seedream 5.0 Lite Edit",
    "description": "Remix existing visuals with Seedream 5.0 Lite using text instructions and multiple reference images, with support for batch output.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Seedream 5.0 Lite Edit",
        "operationId": "submit_bytedance_seedream_v5_lite_edit",
        "description": "Submit an asynchronous image editing task. Provide a prompt containing 3–3,000 characters. Custom size width and height are positive integers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "bytedance/seedream/v5/lite/edit",
                    "enum": [
                      "bytedance/seedream/v5/lite/edit"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 3000,
                        "description": "Describe the requested changes using 3–3,000 characters, counted after leading and trailing whitespace is trimmed."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public HTTP(S) URL of a JPEG or PNG image."
                        },
                        "minItems": 1,
                        "maxItems": 10,
                        "description": "1–10 ordered HTTP(S) reference image URLs. Formats: JPEG, PNG."
                      },
                      "size": {
                        "oneOf": [
                          {
                            "type": "string",
                            "enum": [
                              "2K",
                              "3K",
                              "1:1",
                              "4:3",
                              "3:4",
                              "16:9",
                              "9:16",
                              "3:2",
                              "2:3",
                              "21:9"
                            ],
                            "description": "Resolution or aspect-ratio preset."
                          },
                          {
                            "type": "string",
                            "pattern": "^\\s*\\d+\\s*[xX]\\s*\\d+\\s*$",
                            "description": "Custom dimensions, for example 2304x1728. Width and height are positive integers."
                          },
                          {
                            "type": "object",
                            "required": [
                              "width",
                              "height"
                            ],
                            "properties": {
                              "width": {
                                "type": "integer",
                                "description": "Output width in pixels; a positive integer.",
                                "minimum": 1
                              },
                              "height": {
                                "type": "integer",
                                "description": "Output height in pixels; a positive integer.",
                                "minimum": 1
                              }
                            },
                            "additionalProperties": false,
                            "description": "Custom dimensions as an object with positive integer width and height."
                          }
                        ],
                        "default": "1:1",
                        "description": "Output size: 2K, 3K, a ratio preset, a WIDTHxHEIGHT string, or an object with positive integer width and height. Default: 1:1."
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "default": 1,
                        "description": "Number of images to generate, from 1 to 15. Default: 1."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "Set true to enable safety checking or false to disable it. Default: true."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) URL for task completion notifications."
                  }
                },
                "description": "Set model and optional callback_url at the request root. Place generation parameters inside input."
              },
              "examples": {
                "edit-01": {
                  "summary": "The Weaver's Courtyard",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural documentary photograph. Use the elderly woman from image 1 with exactly the same face, wrinkles, eyes, braids tied with red yarn, black montera hat with the red band and magenta shawl with the silver pin. Use the backstrap loom and half-finished textile from image 2, keeping the same red, deep green and golden yellow diamond and zigzag pattern with the small white llama figures. Set the scene in the adobe courtyard from image 3 with its ochre walls, blue door, clay pot of geraniums and the terraces and snowy peaks beyond the low wall. The woman kneels on the straw mat in three-quarter view; the far end bar of the loom is tied to the wooden post, the near bar is attached to a strap around her waist, and her hands pass the weaving sword through the warp threads. Relight her and the loom with the same warm low afternoon sun from the left and matching long shadows, consistent scale and perspective, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-03.png"
                      ],
                      "size": "4:3",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "edit-02": {
                  "summary": "Widening the Fjord",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Extend image 1 into a wide 21:9 panoramic photograph. Keep the kayaker, the red kayak, the yellow paddle, the V-shaped wake and the turquoise-green water exactly as they are, with the same size, angle and relative position. Naturally expand the scene on both sides and upward: continue the steep dark rock cliff on the right to its full height and add a tall thin waterfall pouring down it into the fjord with mist at its base; on the left reveal a far shoreline with green meadows, three small red wooden boathouses at the waterline and layered mountain ridges fading into haze. Show the cliff tops and a soft overcast sky. Seamless continuation of light, reflections and water texture with no visible seams or borders, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/02/input-01.png"
                      ],
                      "size": "21:9",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "edit-03": {
                  "summary": "Park Chess as a Linocut",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Redraw image 1 in the exact visual style of image 2. Image 1 defines all content: keep the same composition and framing, the two elderly players with their facial features, poses and clothing, the standing onlooker with folded arms, the chess table with the pieces in the same positions, the jacaranda trees and the three pigeons. Image 2 defines only the style: a two-color linocut relief print on off-white textured paper with bold carved black lines, visible gouge marks, parallel hatching for shading, flat rust-red ink for the shirts, the cardigan and the jacaranda blossoms, slightly uneven ink coverage and visible paper grain. Do not copy any boats, harbor, lighthouse or seagulls from image 2. No text, no signature, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/03/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/03/input-02.png"
                      ],
                      "size": "3:2",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural documentary photograph. Use the elderly woman from image 1 with exactly the same face, wrinkles, eyes, braids tied with red yarn, black montera hat with the red band and magenta shawl with the silver pin. Use the backstrap loom and half-finished textile from image 2, keeping the same red, deep green and golden yellow diamond and zigzag pattern with the small white llama figures. Set the scene in the adobe courtyard from image 3 with its ochre walls, blue door, clay pot of geraniums and the terraces and snowy peaks beyond the low wall. The woman kneels on the straw mat in three-quarter view; the far end bar of the loom is tied to the wooden post, the near bar is attached to a strap around her waist, and her hands pass the weaving sword through the warp threads. Relight her and the loom with the same warm low afternoon sun from the left and matching long shadows, consistent scale and perspective, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-03.png"
                      ],
                      "size": "4:3",
                      "n": 1,
                      "enable_safety_checker": true
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                },
                "custom-string": {
                  "summary": "Custom size string",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural documentary photograph. Use the elderly woman from image 1 with exactly the same face, wrinkles, eyes, braids tied with red yarn, black montera hat with the red band and magenta shawl with the silver pin. Use the backstrap loom and half-finished textile from image 2, keeping the same red, deep green and golden yellow diamond and zigzag pattern with the small white llama figures. Set the scene in the adobe courtyard from image 3 with its ochre walls, blue door, clay pot of geraniums and the terraces and snowy peaks beyond the low wall. The woman kneels on the straw mat in three-quarter view; the far end bar of the loom is tied to the wooden post, the near bar is attached to a strap around her waist, and her hands pass the weaving sword through the warp threads. Relight her and the loom with the same warm low afternoon sun from the left and matching long shadows, consistent scale and perspective, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-03.png"
                      ],
                      "size": "2304x1728",
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                },
                "custom-object": {
                  "summary": "Custom size object",
                  "value": {
                    "model": "bytedance/seedream/v5/lite/edit",
                    "input": {
                      "prompt": "Combine the three reference images into one natural documentary photograph. Use the elderly woman from image 1 with exactly the same face, wrinkles, eyes, braids tied with red yarn, black montera hat with the red band and magenta shawl with the silver pin. Use the backstrap loom and half-finished textile from image 2, keeping the same red, deep green and golden yellow diamond and zigzag pattern with the small white llama figures. Set the scene in the adobe courtyard from image 3 with its ochre walls, blue door, clay pot of geraniums and the terraces and snowy peaks beyond the low wall. The woman kneels on the straw mat in three-quarter view; the far end bar of the loom is tied to the wooden post, the near bar is attached to a strap around her waist, and her hands pass the weaving sword through the warp threads. Relight her and the loom with the same warm low afternoon sun from the left and matching long shadows, consistent scale and perspective, no text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/bytedance/seedream/v5/lite/edit/v1/01/input-03.png"
                      ],
                      "size": {
                        "width": 2304,
                        "height": 1728
                      },
                      "n": 1,
                      "enable_safety_checker": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "MYBFV6M8G3QZ4W4C",
                    "status": "running",
                    "created_time": "2026-09-25T16:21:48"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation or account balance error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
