{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Grok Imagine Text to Image",
    "description": "Turn text prompts into images with Grok Imagine, exploring visual ideas in square, portrait, and landscape formats.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Grok Imagine Text to Image",
        "operationId": "submit_xai_grok_imagine_image_text_to_image",
        "description": "Submit a text prompt using the parameters below to generate an image.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "xai/grok-imagine-image/text-to-image"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "maxLength": 5000,
                        "minLength": 1,
                        "description": "Describe the desired image and visual style. Enter 1–5,000 characters."
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "9:16",
                          "16:9"
                        ],
                        "description": "Optional output image aspect ratio: 1:1, 2:3, 3:2, 16:9, or 9:16."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Set model and callback_url at the request root. Place generation parameters inside input."
              },
              "examples": {
                "basic": {
                  "summary": "Basic workflow",
                  "value": {
                    "model": "xai/grok-imagine-image/text-to-image",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail."
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "xai/grok-imagine-image/text-to-image",
                    "input": {
                      "prompt": "A quiet forest under soft morning light, with natural detail."
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-example",
                    "status": "running",
                    "created_time": "2026-09-10T08:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Review the input values, media accessibility, and account balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
