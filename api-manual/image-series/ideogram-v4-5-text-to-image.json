{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Ideogram 4.5 Text to Image",
    "description": "The Ideogram 4.5 Text to Image API generates 1–8 posters, logos and text-rich images per request, with low, medium or high quality and 42 sizes.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Ideogram 4.5 Text to Image",
        "operationId": "submit_ideogram_v4_5_text_to_image",
        "description": "Send only the `input` fields listed for this model. Any other field, including image inputs, returns 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `ideogram/v4.5/text-to-image`.",
                    "example": "ideogram/v4.5/text-to-image"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000,
                        "description": "Text prompt. Put any words that must appear in the image in quotes. 1–10,000 characters, not blank.",
                        "example": "A retro travel poster for \"LISBON 1932\", tram climbing a sunny hill, bold art deco lettering"
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8,
                        "default": 1,
                        "description": "Number of images to generate."
                      },
                      "quality": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ],
                        "default": "medium",
                        "description": "Rendering quality. It sets the billing rate."
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "1:1 HD",
                          "4:3",
                          "3:4",
                          "16:9",
                          "9:16",
                          "1024x1024",
                          "1024x3072",
                          "1120x896",
                          "1152x2944",
                          "1152x864",
                          "1248x3328",
                          "1248x832",
                          "1280x3072",
                          "1280x720",
                          "1280x800",
                          "1296x3168",
                          "1440x2560",
                          "1440x2880",
                          "1440x720",
                          "1600x2560",
                          "1664x2496",
                          "1728x2304",
                          "1792x2240",
                          "2048x2048",
                          "2240x1792",
                          "2304x1728",
                          "2496x1664",
                          "2560x1440",
                          "2560x1600",
                          "2880x1440",
                          "2944x1152",
                          "3072x1024",
                          "3072x1280",
                          "3168x1296",
                          "3328x1248",
                          "720x1280",
                          "720x1440",
                          "800x1280",
                          "832x1248",
                          "864x1152",
                          "896x1120"
                        ],
                        "default": "1:1 HD",
                        "description": "Output size: an aspect-ratio preset (`1:1 HD` is the higher-resolution square) or one of the exact pixel sizes in the list."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "poster": {
                  "summary": "Poster with lettering",
                  "value": {
                    "model": "ideogram/v4.5/text-to-image",
                    "input": {
                      "prompt": "A retro travel poster for \"LISBON 1932\", tram climbing a sunny hill, bold art deco lettering",
                      "n": 1,
                      "quality": "medium",
                      "size": "3:4"
                    }
                  }
                },
                "logo_variants": {
                  "summary": "Four high-quality logo options with callback",
                  "value": {
                    "model": "ideogram/v4.5/text-to-image",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Minimal flat logo for a coffee roastery called \"Ember & Oak\", warm orange on cream",
                      "n": 4,
                      "quality": "high",
                      "size": "1024x1024"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported field, inaccessible media, or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ],
                      "description": "Error message."
                    }
                  }
                }
              }
            }
          },
          "401": {
