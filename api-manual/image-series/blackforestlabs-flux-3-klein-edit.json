{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX 3 Klein Edit",
    "description": "The FLUX 3 Klein Edit API edits or combines 1–10 input images from a natural-language instruction and returns 1–4 results at 1K, 2K or 4K.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "FLUX 3 Klein Edit",
        "operationId": "submit_blackforestlabs_flux_3_klein_edit",
        "description": "Send only the `input` fields listed for this model. Any other field returns 400. `image_urls` takes 1–10 public HTTP(S) URLs; base64 data URIs are uploaded first. A custom `WIDTHxHEIGHT` size needs a `resolution` that matches its long edge.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `blackforestlabs/flux-3-klein/edit`.",
                    "example": "blackforestlabs/flux-3-klein/edit"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "image_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Place the bottle from the first image on the beach in the second image, keep the label readable",
                        "description": "Edit instruction. Refer to inputs by order, for example \"the first image\". Must not be blank."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 10,
                        "example": [
                          "https://example.com/bottle.png"
                        ],
                        "description": "1–10 images to edit or combine: public HTTP(S) URLs or base64 data URIs (uploaded first). Order matters when the prompt refers to images by position."
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4,
                        "default": 1,
                        "description": "Number of images to generate."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "1K",
                          "2K",
                          "4K"
                        ],
                        "default": "1K",
                        "description": "Resolution tier (case-insensitive). Presets are scaled so the long edge is 1024, 2048 or 4096 px. It sets the billing rate. With a custom `size`, send the tier that matches its long edge."
                      },
                      "size": {
                        "type": "string",
                        "default": "1:1",
                        "example": "16:9",
                        "description": "Aspect-ratio preset (`1:1`, `4:3`, `3:4`, `16:9`, `9:16`, `3:2`, `2:3`) or a custom `WIDTHxHEIGHT` with each side 256–4096 and a multiple of 16. A custom size needs an explicit `resolution` matching its long edge: up to 1024 → `1K`, up to 2048 → `2K`, otherwise `4K`."
                      },
                      "output_format": {
                        "type": "string",
                        "enum": [
                          "png",
                          "jpeg",
                          "webp"
                        ],
                        "default": "png",
                        "description": "Image file format."
                      },
                      "enable_safety_checker": {
                        "type": "boolean",
                        "default": true,
                        "description": "Run the upstream safety checker."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "single_edit": {
                  "summary": "Edit one image",
                  "value": {
                    "model": "blackforestlabs/flux-3-klein/edit",
                    "input": {
                      "prompt": "Turn the daytime street into a rainy night scene with glowing shop windows",
                      "image_urls": [
                        "https://example.com/street.jpg"
                      ],
                      "n": 1,
                      "resolution": "1K",
                      "size": "16:9",
                      "output_format": "png"
                    }
                  }
                },
                "compose": {
                  "summary": "Combine two images at 2K with callback",
                  "value": {
                    "model": "blackforestlabs/flux-3-klein/edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Place the bottle from the first image on the beach in the second image, keep the label readable",
                      "image_urls": [
                        "https://example.com/bottle.png",
                        "https://example.com/beach.jpg"
                      ],
                      "n": 2,
                      "resolution": "2K",
                      "size": "4:3",
                      "output_format": "webp"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
