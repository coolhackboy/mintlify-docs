{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Ideogram 4.5 Edit",
    "description": "The Ideogram 4.5 Edit API edits one image from a text instruction, with an optional mask, up to 4 reference images and regular or high edit precision.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "Ideogram 4.5 Edit",
        "operationId": "submit_ideogram_v4_5_edit",
        "description": "Send only the `input` fields listed for this model. Any other field returns 400. `mask_url` and `edit_precision: high` both require `size: auto`. Image fields accept public HTTP(S) URLs or `data:image/...;base64,...` data URIs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID. Use `ideogram/v4.5/edit`.",
                    "example": "ideogram/v4.5/edit"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint that receives a POST when the task becomes `finished` or `failed`. HTTPS is recommended. Omit it, or send `null` or an empty string, to disable callbacks.",
                    "example": "https://your-domain.com/callback"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "prompt",
                      "image_urls"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000,
                        "example": "Change the shop sign to read \"OPEN LATE\" in neon pink",
                        "description": "Edit instruction: what to change and how. 1–10,000 characters, not blank."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 1,
                        "example": [
                          "https://example.com/storefront.png"
                        ],
                        "description": "Exactly one image to edit: a public HTTP(S) URL or an image data URI."
                      },
                      "mask_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Optional mask of the area to edit, the same size as the source image. Black marks the area to edit, white the area to keep. Requires `size: auto`. Public HTTP(S) URL or image data URI."
                      },
                      "reference_image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri"
                        },
                        "maxItems": 4,
                        "description": "Optional style or content references: up to 4 images, or up to 3 when `mask_url` is set. References guide the edit and are not edited themselves. Public HTTP(S) URLs or image data URIs."
                      },
                      "edit_precision": {
                        "type": "string",
                        "enum": [
                          "regular",
                          "high"
                        ],
                        "default": "regular",
                        "description": "`regular` or `high`. `high` keeps unchanged pixels intact more strictly and requires `size: auto`."
                      },
                      "quality": {
                        "type": "string",
                        "enum": [
                          "very_low",
                          "low",
                          "medium",
                          "high"
                        ],
                        "default": "medium",
                        "description": "Rendering quality. It sets the billing rate. `very_low` is available on this edit ID only."
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8,
                        "default": 1,
                        "description": "Number of images to generate."
                      },
                      "size": {
                        "type": "string",
                        "default": "auto",
                        "example": "auto",
                        "description": "Output size. `auto` keeps the source image's size. Otherwise use a preset (`1:1`, `1:1 HD`, `4:3`, `3:4`, `16:9`, `9:16`) or `WIDTHxHEIGHT` with each side at least 256 and a multiple of 32, at most 4,194,304 pixels in total and an aspect ratio no wider than 6:1. Must be `auto` with `mask_url` or `edit_precision: high`."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Generation parameters."
                  }
                }
              },
              "examples": {
                "instruction_edit": {
                  "summary": "Instruction-only edit",
                  "value": {
                    "model": "ideogram/v4.5/edit",
                    "input": {
                      "prompt": "Change the shop sign to read \"OPEN LATE\" in neon pink",
                      "image_urls": [
                        "https://example.com/storefront.png"
                      ],
                      "quality": "medium",
                      "n": 1,
                      "size": "auto"
                    }
                  }
                },
                "masked_edit": {
                  "summary": "Masked edit with a reference and high precision",
                  "value": {
                    "model": "ideogram/v4.5/edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Replace the sofa with the green velvet armchair from the reference image",
                      "image_urls": [
                        "https://example.com/living-room.png"
                      ],
                      "mask_url": "https://example.com/sofa-mask.png",
                      "reference_image_urls": [
                        "https://example.com/armchair.png"
                      ],
                      "edit_precision": "high",
                      "quality": "high",
                      "n": 1,
                      "size": "auto"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ],
                      "description": "HTTP status code."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string",
                          "description": "Task ID. Use it with [Query Task Status](/api-manual/task-management/status)."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started"
                          ],
                          "description": "Initial task status."
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Time the task was created (ISO 8601)."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "task-unified-1762160000-abc123",
                    "status": "not_started",
                    "created_time": "2026-11-03T10:30:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported field, inaccessible media, or insufficient credits",
