{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - Z-Image Turbo",
    "description": "Text-to-image generation and single-image editing with Z-Image Turbo.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Z-Image Turbo Task",
        "operationId": "submitZImageTurboTask",
        "tags": [
          "Z-Image Turbo"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "Text to image",
                  "value": {
                    "model": "alibaba/z-image/turbo",
                    "input": {
                      "prompt": "A ceramic vase on a wooden table in soft daylight.",
                      "size": "1:1",
                      "enable_safety_checker": true
                    }
                  }
                },
                "image-editing": {
                  "summary": "Image editing",
                  "value": {
                    "model": "alibaba/z-image/turbo",
                    "input": {
                      "prompt": "Add soft studio lighting to this product photo.",
                      "image_urls": [
                        "https://example.com/reference.png"
                      ],
                      "enable_safety_checker": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "description": "Generate an image from a prompt or edit one reference image."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Use `Authorization: Bearer VIDGO_API_KEY`."
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "alibaba/z-image/turbo"
            ],
            "example": "alibaba/z-image/turbo",
            "description": "Z-Image Turbo model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook callback URL."
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "Image generation parameters. size is required for text-to-image and optional when image_urls supplies an editing reference.",
            "anyOf": [
              {
                "required": [
                  "size"
                ]
              },
              {
                "required": [
                  "image_urls"
                ]
              }
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Describe the image to generate or the edits to apply. Contains 1 to 1000 characters.",
                "example": "A ceramic vase on a wooden table in soft daylight."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "description": "One HTTP(S) image URL used as the editing reference. Providing this field selects image editing.",
                "example": [
                  "https://example.com/reference.png"
                ]
              },
              "size": {
                "type": "string",
                "enum": [
                  "1:1",
                  "4:3",
                  "3:4",
                  "16:9",
                  "9:16"
                ],
                "description": "Output aspect ratio. Required for text-to-image; optional for image editing.",
                "example": "1:1"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Enable the safety checker. Defaults to true.",
                "example": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "failed"
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
