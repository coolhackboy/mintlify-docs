{
  "openapi": "3.0.0",
  "info": {
    "title": "Vidgo API - FLUX.2 Pro Edit",
    "description": "Combine visual references with text instructions in FLUX.2 Pro to edit scenes, transfer styles, and retain recognizable subjects.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vidgo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "tags": [
          "Image Series"
        ],
        "summary": "FLUX.2 Pro Edit",
        "operationId": "submit_blackforestlabs_flux_2_pro_edit",
        "description": "Send the fields shown for this workflow. Place `prompt`, `image_urls`, `size`, and `resolution` inside `input`. Each `image_urls` item is a public HTTP(S) URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "blackforestlabs/flux-2-pro/edit"
                  },
                  "input": {
                    "type": "object",
                    "required": [
                      "image_urls",
                      "prompt",
                      "resolution",
                      "size"
                    ],
                    "properties": {
                      "prompt": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 5000,
                        "description": "Text instructions for editing the reference images, 3-5,000 characters."
                      },
                      "image_urls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public HTTP(S) image URL."
                        },
                        "minItems": 1,
                        "maxItems": 8,
                        "description": "Reference images, 1-8 public HTTP(S) URLs."
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "4:3",
                          "3:4",
                          "16:9",
                          "9:16",
                          "3:2",
                          "2:3",
                          "auto"
                        ],
                        "description": "Aspect ratio of the output image. `auto` uses the aspect ratio of the first image in `image_urls`."
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "1K",
                          "2K"
                        ],
                        "description": "Output image resolution."
                      }
                    },
                    "additionalProperties": false
                  },
                  "callback_url": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional public HTTP(S) endpoint for task completion notifications. HTTPS is recommended. Omit, use null, or use an empty string to disable callbacks."
                  }
                },
                "description": "Keep model and callback_url at the root. Place workflow parameters inside input."
              },
              "examples": {
                "default": {
                  "summary": "Dumpling Lesson",
                  "value": {
                    "model": "blackforestlabs/flux-2-pro/edit",
                    "input": {
                      "prompt": "Using image 1 (the grandmother) and image 2 (the boy) as identity references and image 3 as the location, create one warm documentary photograph of the grandmother teaching the boy to fold jiaozi dumplings at the flour-dusted wooden table in the kitchen from image 3. Keep both people exactly recognisable: the grandmother's pinned silver hair with black clip, smile lines, maroon knitted cardigan, white collar and jade earrings; the boy's bowl haircut, missing front tooth, mustard corduroy overalls and striped shirt. The grandmother stands beside and slightly behind the boy, guiding his small hands as he pinches a dumpling closed; a tray of neat finished dumplings and a few lopsided ones sits in front of him, with a rolling pin and a bowl of pork-and-chive filling nearby. Preserve the brick stove, iron wok, bamboo steamer, frosted window with red paper-cuts, and hanging garlic and chillies from image 3. Soft afternoon window light, a little flour in the air, natural skin texture, believable hands, 35mm lens. No text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-03.png"
                      ],
                      "size": "3:2",
                      "resolution": "1K"
                    }
                  }
                },
                "pro-edit-02": {
                  "summary": "Lisbon Tram Hill in Gouache",
                  "value": {
                    "model": "blackforestlabs/flux-2-pro/edit",
                    "input": {
                      "prompt": "Repaint image 1 in the painting style of image 2. Keep the exact composition, perspective, street geometry, tram position, building layout, balconies, laundry and river glimpse of image 1. Take only the medium and palette from image 2: flat opaque gouache shapes, matte chalky brush strokes, simplified forms, a limited palette of ochre, sage green, cobalt blue and warm off-white, and visible cold-press paper texture at the edges. The tram stays yellow, rendered as a muted gouache ochre. Do not add the pears, jug or cloth from image 2. No text, no signature, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/02/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/02/input-02.png"
                      ],
                      "size": "3:4",
                      "resolution": "1K"
                    }
                  }
                },
                "pro-edit-03": {
                  "summary": "Platform Chalkboard Update",
                  "value": {
                    "model": "blackforestlabs/flux-2-pro/edit",
                    "input": {
                      "prompt": "Edit only the handwriting on the chalkboard in image 1. Replace the three chalk lines with exactly: first line \"NEXT TRAIN\", second line \"08:05 DELAYED\", third line \"SNOW ON THE LINE\". Match the original white chalk stroke texture, letter size, slant, dusty smudges and line spacing. Keep everything else in image 1 unchanged: the framing, chalkboard position and size, easel, waiting shelter, bench, platform, yellow line, track, forest, mountains, dry overcast weather, lighting and camera angle. No extra text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/03/input-01.png"
                      ],
                      "size": "4:3",
                      "resolution": "1K"
                    }
                  }
                },
                "callback": {
                  "summary": "Receive a completion callback",
                  "value": {
                    "model": "blackforestlabs/flux-2-pro/edit",
                    "input": {
                      "prompt": "Using image 1 (the grandmother) and image 2 (the boy) as identity references and image 3 as the location, create one warm documentary photograph of the grandmother teaching the boy to fold jiaozi dumplings at the flour-dusted wooden table in the kitchen from image 3. Keep both people exactly recognisable: the grandmother's pinned silver hair with black clip, smile lines, maroon knitted cardigan, white collar and jade earrings; the boy's bowl haircut, missing front tooth, mustard corduroy overalls and striped shirt. The grandmother stands beside and slightly behind the boy, guiding his small hands as he pinches a dumpling closed; a tray of neat finished dumplings and a few lopsided ones sits in front of him, with a rolling pin and a bowl of pork-and-chive filling nearby. Preserve the brick stove, iron wok, bamboo steamer, frosted window with red paper-cuts, and hanging garlic and chillies from image 3. Soft afternoon window light, a little flour in the air, natural skin texture, believable hands, 35mm lens. No text, no watermark.",
                      "image_urls": [
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-01.png",
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-02.png",
                        "https://cdn.vidgo.ai/apis/models/blackforestlabs/flux-2-pro/edit/v1/01/input-03.png"
                      ],
                      "size": "3:2",
                      "resolution": "1K"
                    },
                    "callback_url": "https://your-domain.com/callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "task_id",
                        "status",
                        "created_time"
                      ],
                      "properties": {
                        "task_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "running",
                            "finished",
                            "failed"
                          ]
                        },
                        "created_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "G4SI8DYZSIKS9UV5",
                    "status": "running",
                    "created_time": "2026-09-26T10:37:28"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, inaccessible media, or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown or disabled model",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
